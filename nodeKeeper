# ==============================================================================
# Maintenance Script & Cron Management
# ==============================================================================
generate_maintenance_script() {
    mkdir -p "$NK_DIR" "$NK_LOG_DIR"
    cat > "$NK_MAINT_SCRIPT" <<'EOF'
#!/usr/bin/env bash
export DEBIAN_FRONTEND=noninteractive
NK_DIR="/opt/nodekeeper"
NK_ENV="${NK_DIR}/nodekeeper.env"
LOG_DIR="${NK_DIR}/logs"
mkdir -p "$LOG_DIR"

if [ -f "$NK_ENV" ]; then
    source "$NK_ENV"
fi

MAINT_MIN_DAYS="${MAINT_MIN_DAYS:-5}"
MAINT_MAX_DAYS="${MAINT_MAX_DAYS:-10}"
MAINT_LOGGING="${MAINT_LOGGING:-true}"
MAINT_EXTRA_CMD="${MAINT_EXTRA_CMD:-}"

DATE=$(date +%Y-%m-%d_%H-%M)
if [ "$MAINT_LOGGING" = "true" ]; then
    LOG_FILE="${LOG_DIR}/update_${DATE}.log"
    TEST_LOG="${LOG_DIR}/tests_${DATE}.log"
else
    LOG_FILE="/dev/null"
    TEST_LOG="/dev/null"
fi

{
    echo "=== Maintenance started: $DATE ==="
    if [ -d /opt/remnanode ] && [ -f /opt/remnanode/docker-compose.yml ]; then
        cd /opt/remnanode && /usr/bin/docker compose pull
    fi
    /usr/bin/apt-get update && /usr/bin/apt-get upgrade -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold"
    if [ -d /opt/remnanode ] && [ -f /opt/remnanode/docker-compose.yml ] && [ "${SERVER_DISABLED:-false}" != "true" ]; then
        cd /opt/remnanode && /usr/bin/docker compose up -d --build
    fi
    if [ -n "$MAINT_EXTRA_CMD" ]; then
        echo "--- Running custom command: $MAINT_EXTRA_CMD ---"
        eval "$MAINT_EXTRA_CMD"
    fi
    echo "=== Maintenance completed ==="
} >> "$LOG_FILE" 2>&1

if [ "$MAINT_LOGGING" = "true" ]; then
    {
        echo "=== Diagnostics: $DATE ==="
        wget -qO - "https://raw.githubusercontent.com/vernette/ipregion/refs/heads/master/ipregion.sh" | bash
        wget -qO - "https://github.com/vernette/censorcheck/raw/master/censorcheck.sh" | bash
    } >> "$TEST_LOG" 2>&1

    find "$LOG_DIR" -type f -name "*.log" -mtime +30 -delete 2>/dev/null || true
fi

# Schedule next run
SPAN=$(( MAINT_MAX_DAYS - MAINT_MIN_DAYS + 1 ))
[ "$SPAN" -lt 1 ] && SPAN=1
NEXT_DAYS=$(( ( RANDOM % SPAN ) + MAINT_MIN_DAYS ))
NEXT_HOUR=$(( RANDOM % 24 ))
NEXT_MIN=$(( RANDOM % 60 ))
NEXT_DATE=$(date -d "+${NEXT_DAYS} days" +%d)
NEXT_MONTH=$(date -d "+${NEXT_DAYS} days" +%m)

CRON_JOB="${NEXT_MIN} ${NEXT_HOUR} ${NEXT_DATE} ${NEXT_MONTH} * /bin/bash ${NK_DIR}/maintenance.sh"
(crontab -l 2>/dev/null | grep -v "maintenance.sh"; echo "$CRON_JOB") | crontab -

sleep 10
/usr/sbin/reboot
EOF
    chmod +x "$NK_MAINT_SCRIPT"
}

schedule_enable() {
    generate_maintenance_script
    local span=$(( MAINT_MAX_DAYS - MAINT_MIN_DAYS + 1 ))
    [ "$span" -lt 1 ] && span=1
    local next_days=$(( ( RANDOM % span ) + MAINT_MIN_DAYS ))
    local h=$(( RANDOM % 24 ))
    local m=$(( RANDOM % 60 ))
    local d
    local mon
    d=$(date -d "+${next_days} days" +%d 2>/dev/null || date +%d)
    mon=$(date -d "+${next_days} days" +%m 2>/dev/null || date +%m)
    local job="${m} ${h} ${d} ${mon} * /bin/bash ${NK_MAINT_SCRIPT}"
    (crontab -l 2>/dev/null | grep -v "maintenance.sh"; echo "$job") | crontab -
    MAINT_ENABLED="true"
    save_env
    ok "Maintenance schedule ENABLED (Next run in ~${next_days} days: ${d}.${mon} at $(printf '%02d:%02d' "$h" "$m"))."
}

schedule_disable() {
    (crontab -l 2>/dev/null | grep -v "maintenance.sh") | crontab - 2>/dev/null || true
    MAINT_ENABLED="false"
    save_env
    ok "Maintenance schedule DISABLED."
}

schedule_status() {
    echo -e "${C_BOLD}--- Maintenance Schedule Status ---${C_RESET}"
    echo -e "Enabled:           ${C_CYAN}${MAINT_ENABLED}${C_RESET}"
    echo -e "Interval Range:    ${C_CYAN}${MAINT_MIN_DAYS}-${MAINT_MAX_DAYS} days${C_RESET}"
    echo -e "Logging Enabled:   ${C_CYAN}${MAINT_LOGGING}${C_RESET} (${NK_LOG_DIR})"
    echo -e "Extra Command:     ${C_CYAN}${MAINT_EXTRA_CMD:-<none>}${C_RESET}"
    local cron_line
    cron_line=$(crontab -l 2>/dev/null | grep "maintenance.sh" || true)
    if [ -n "$cron_line" ]; then
        echo -e "Active Crontab:    ${C_GREEN}${cron_line}${C_RESET}"
    else
        echo -e "Active Crontab:    ${C_YELLOW}Not scheduled${C_RESET}"
    fi
}

# ==============================================================================
# Service & Mode Controls
# ==============================================================================
apply_firewall() {
    if ! command -v ufw >/dev/null 2>&1; then
        return 0
    fi
    ufw allow "${SSH_PORT}/tcp" comment 'SSH' >/dev/null 2>&1 || true
    if [ "$SERVER_DISABLED" = "true" ]; then
        ufw delete allow 80/tcp >/dev/null 2>&1 || true
        ufw delete allow 443/tcp >/dev/null 2>&1 || true
        ufw delete allow 443/udp >/dev/null 2>&1 || true
        if [ -n "$PANEL_IP" ]; then
            ufw delete allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp >/dev/null 2>&1 || true
        fi
    else
        ufw allow 80/tcp comment 'HTTP' >/dev/null 2>&1 || true
        ufw allow 443/tcp comment 'HTTPS-REALITY' >/dev/null 2>&1 || true
        ufw allow 443/udp comment 'QUIC-Hysteria' >/dev/null 2>&1 || true
        if [ -n "$PANEL_IP" ]; then
            ufw allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp comment 'Remnawave-Panel' >/dev/null 2>&1 || true
        fi
    fi
    ufw reload >/dev/null 2>&1 || true
}

cmd_status() {
    echo -e "\n${C_BOLD}====================================================================${C_RESET}"
    echo -e "${C_BOLD}                 nodeKeeper v${NK_VERSION} — Node Status${C_RESET}"
    echo -e "${C_BOLD}====================================================================${C_RESET}"
    echo -e "Hostname:          ${C_CYAN}$(hostname)${C_RESET}"
    echo -e "Install Mode:      ${C_CYAN}${INSTALL_MODE}${C_RESET}"
    echo -e "Server Disabled:   ${C_CYAN}${SERVER_DISABLED}${C_RESET}"
    [ -n "$SELF_STEAL_DOMAIN" ] && echo -e "Selfsteal Domain:  ${C_CYAN}${SELF_STEAL_DOMAIN}${C_RESET}"
    echo -e "Panel IP:          ${C_CYAN}${PANEL_IP:-<not set>}${C_RESET} (Port: ${NODE_PORT})"
    echo -e "Admin User:        ${C_CYAN}${ADMIN_USER}${C_RESET} (SSH Port: ${SSH_PORT})"
    echo -e "--------------------------------------------------------------------"

    # Docker containers
    echo -e "${C_BOLD}Containers:${C_RESET}"
    if command -v docker >/dev/null 2>&1 && [ -f "${REMNA_DIR}/docker-compose.yml" ]; then
        (cd "$REMNA_DIR" && docker compose ps)
    else
        echo -e "  ${C_YELLOW}No compose stack found in ${REMNA_DIR}${C_RESET}"
    fi
    echo -e "--------------------------------------------------------------------"

    # WARP status
    echo -e "${C_BOLD}Cloudflare WARP:${C_RESET}"
    if ip link show warp >/dev/null 2>&1; then
        echo -e "  Interface warp: ${C_GREEN}UP${C_RESET}"
    else
        echo -e "  Interface warp: ${C_YELLOW}DOWN / Not installed${C_RESET}"
    fi

    # Fail2ban status
    if systemctl is-active --quiet fail2ban 2>/dev/null; then
        echo -e "Fail2ban:          ${C_GREEN}Active${C_RESET}"
    else
        echo -e "Fail2ban:          ${C_YELLOW}Inactive${C_RESET}"
    fi

    # BBR status
    local cc
    cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "unknown")
    echo -e "TCP Congestion:    ${C_CYAN}${cc}${C_RESET}"
    echo -e "--------------------------------------------------------------------"
    schedule_status
    echo -e "${C_BOLD}====================================================================${C_RESET}\n"
}

cmd_start() {
    SERVER_DISABLED="false"
    save_env
    apply_firewall
    if [ -f "${REMNA_DIR}/docker-compose.yml" ]; then
        info "Starting containers in ${REMNA_DIR}..."
        (cd "$REMNA_DIR" && docker compose up -d --build --remove-orphans)
        ok "Node services started."
    else
        err "Compose file not found at ${REMNA_DIR}/docker-compose.yml"
    fi
}

cmd_stop() {
    if [ -f "${REMNA_DIR}/docker-compose.yml" ]; then
        info "Stopping containers in ${REMNA_DIR}..."
        (cd "$REMNA_DIR" && docker compose down)
        ok "Node services stopped."
    fi
}

cmd_restart() {
    if [ -f "${REMNA_DIR}/docker-compose.yml" ]; then
        info "Restarting containers in ${REMNA_DIR}..."
        (cd "$REMNA_DIR" && docker compose down && docker compose up -d --build --remove-orphans)
        ok "Node services restarted."
    fi
}

cmd_disable_server() {
    warn "Disabling node services and closing proxy firewall ports..."
    cmd_stop
    SERVER_DISABLED="true"
    save_env
    apply_firewall
    ok "Server is now DISABLED. Run 'nodeKeeper enable' to re-enable."
}

cmd_enable_server() {
    info "Re-enabling node services and restoring firewall rules..."
    cmd_start
    ok "Server is now ENABLED."
}

cmd_switch_mode() {
    local target_mode="${1:-}"
    if [ -z "$target_mode" ]; then
        echo -e "\n${C_BOLD}Select Installation Mode:${C_RESET}"
        echo "  1) basic            — Remnanode only (no Caddy)"
        echo "  2) selfsteal-single — Remnanode + Caddy (one server per domain)"
        echo "  3) selfsteal-multi  — Remnanode + Caddy with Cloudflare DNS plugin (multi-server)"
        read -rp "Enter choice [1-3]: " m_choice
        case "$m_choice" in
            1) target_mode="basic" ;;
            2) target_mode="selfsteal-single" ;;
            3) target_mode="selfsteal-multi" ;;
            *) err "Invalid selection."; return 1 ;;
        esac
    fi

    case "$target_mode" in
        basic|no-caddy)
            target_mode="basic"
            ;;
        selfsteal-single|single|selfsteal)
            target_mode="selfsteal-single"
            if [ -z "$SELF_STEAL_DOMAIN" ]; then
                read -rp "Enter Selfsteal Domain (e.g. node.example.com): " SELF_STEAL_DOMAIN
            fi
            ;;
        selfsteal-multi|multi|cloudflare)
            target_mode="selfsteal-multi"
            if [ -z "$SELF_STEAL_DOMAIN" ]; then
                read -rp "Enter Selfsteal Domain (e.g. node.example.com): " SELF_STEAL_DOMAIN
            fi
            if [ -z "$CLOUDFLARE_API_TOKEN" ]; then
                read -rp "Enter Cloudflare API Token (DNS Edit permission): " CLOUDFLARE_API_TOKEN
            fi
            ;;
        *)
            err "Invalid mode '$target_mode'. Use: basic | selfsteal-single | selfsteal-multi"
            return 1
            ;;
    esac

    info "Switching mode to: ${target_mode}..."
    if [ -f "${REMNA_DIR}/docker-compose.yml" ]; then
        (cd "$REMNA_DIR" && docker compose down --remove-orphans) || true
    fi
    INSTALL_MODE="$target_mode"
    save_env
    write_mode_configs "$INSTALL_MODE"
    apply_firewall
    (cd "$REMNA_DIR" && docker compose up -d --build --remove-orphans)
    ok "Successfully switched to mode: ${INSTALL_MODE}"
}

cmd_uninstall() {
    local force="${1:-false}"
    if [ "$force" != "--yes" ]; then
        echo -e "${C_RED}${C_BOLD}WARNING: This will completely uninstall Remnanode, Caddy, maintenance cron jobs, and nodeKeeper configurations!${C_RESET}"
        read -rp "Type 'UNINSTALL' to confirm: " confirm
        if [ "$confirm" != "UNINSTALL" ]; then
            info "Uninstall cancelled."
            return 0
        fi
    fi

    info "Stopping and removing Docker containers, volumes, and images..."
    if [ -d "$REMNA_DIR" ] && [ -f "${REMNA_DIR}/docker-compose.yml" ]; then
        (cd "$REMNA_DIR" && docker compose down -v --rmi local --remove-orphans) || true
    fi
    rm -rf "$REMNA_DIR"

    info "Removing maintenance schedule..."
    (crontab -l 2>/dev/null | grep -v "maintenance.sh") | crontab - 2>/dev/null || true

    info "Stopping WARP interface if present..."
    systemctl disable --now wg-quick@warp >/dev/null 2>&1 || true
    rm -f /etc/wireguard/warp.conf

    info "Cleaning up firewall rules..."
    if command -v ufw >/dev/null 2>&1; then
        ufw delete allow 80/tcp >/dev/null 2>&1 || true
        ufw delete allow 443/tcp >/dev/null 2>&1 || true
        ufw delete allow 443/udp >/dev/null 2>&1 || true
        if [ -n "$PANEL_IP" ]; then
            ufw delete allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp >/dev/null 2>&1 || true
        fi
        ufw reload >/dev/null 2>&1 || true
    fi

    info "Removing nodeKeeper files..."
    rm -rf "$NK_DIR"
    sed -i '/alias nodeKeeper=/d' /root/.bashrc 2>/dev/null || true
    if [ -n "$ADMIN_USER" ] && [ -f "/home/${ADMIN_USER}/.bashrc" ]; then
        sed -i '/alias nodeKeeper=/d' "/home/${ADMIN_USER}/.bashrc" 2>/dev/null || true
    fi
    rm -f /usr/local/bin/nodeKeeper /usr/local/bin/nodekeeper

    ok "Full uninstallation complete."
}

