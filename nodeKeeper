#!/usr/bin/env bash
# ==============================================================================
# nodeKeeper — Remnawave Node & Server Control CLI
# ==============================================================================
set -uo pipefail

NK_VERSION="1.0.0"
NK_DIR="/opt/nodekeeper"
NK_ENV="${NK_DIR}/nodekeeper.env"
NK_LOG_DIR="${NK_DIR}/logs"
NK_MAINT_SCRIPT="${NK_DIR}/maintenance.sh"
REMNA_DIR="/opt/remnanode"
HTML_DIR="/var/www/html"

# Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_CYAN="\033[1;36m"
C_BLUE="\033[1;34m"
C_GRAY="\033[0;90m"

info()  { echo -e "${C_CYAN}[INFO]${C_RESET} $*"; }
ok()    { echo -e "${C_GREEN}[OK]${C_RESET} $*"; }
warn()  { echo -e "${C_YELLOW}[WARN]${C_RESET} $*"; }
err()   { echo -e "${C_RED}[ERROR]${C_RESET} $*" >&2; }

ensure_root() {
    if [ "${EUID:-$(id -u)}" -ne 0 ]; then
        if command -v sudo >/dev/null 2>&1; then
            exec sudo -E "$0" "$@"
        else
            err "This utility must be run as root or via sudo."
            exit 1
        fi
    fi
}

load_env() {
    mkdir -p "$NK_DIR" "$NK_LOG_DIR"
    if [ -f "$NK_ENV" ]; then
        # shellcheck disable=SC1090
        source "$NK_ENV"
    fi
    NODE_HOSTNAME="${NODE_HOSTNAME:-$(hostname)}"
    INSTALL_MODE="${INSTALL_MODE:-basic}"
    SELF_STEAL_DOMAIN="${SELF_STEAL_DOMAIN:-}"
    CLOUDFLARE_API_TOKEN="${CLOUDFLARE_API_TOKEN:-}"
    PANEL_IP="${PANEL_IP:-}"
    NODE_PORT="${NODE_PORT:-2222}"
    SECRET_KEY="${SECRET_KEY:-}"
    ADMIN_USER="${ADMIN_USER:-node}"
    SSH_PORT="${SSH_PORT:-22}"
    SERVER_DISABLED="${SERVER_DISABLED:-false}"
    MAINT_ENABLED="${MAINT_ENABLED:-true}"
    MAINT_MIN_DAYS="${MAINT_MIN_DAYS:-5}"
    MAINT_MAX_DAYS="${MAINT_MAX_DAYS:-10}"
    MAINT_LOGGING="${MAINT_LOGGING:-true}"
    MAINT_EXTRA_CMD="${MAINT_EXTRA_CMD:-}"
}

save_env() {
    mkdir -p "$NK_DIR"
    umask 077
    cat > "$NK_ENV" <<EOF
NODE_HOSTNAME=$(printf '%q' "${NODE_HOSTNAME}")
INSTALL_MODE=$(printf '%q' "${INSTALL_MODE}")
SELF_STEAL_DOMAIN=$(printf '%q' "${SELF_STEAL_DOMAIN}")
CLOUDFLARE_API_TOKEN=$(printf '%q' "${CLOUDFLARE_API_TOKEN}")
PANEL_IP=$(printf '%q' "${PANEL_IP}")
NODE_PORT=$(printf '%q' "${NODE_PORT}")
SECRET_KEY=$(printf '%q' "${SECRET_KEY}")
ADMIN_USER=$(printf '%q' "${ADMIN_USER}")
SSH_PORT=$(printf '%q' "${SSH_PORT}")
SERVER_DISABLED=$(printf '%q' "${SERVER_DISABLED}")
MAINT_ENABLED=$(printf '%q' "${MAINT_ENABLED}")
MAINT_MIN_DAYS=$(printf '%q' "${MAINT_MIN_DAYS}")
MAINT_MAX_DAYS=$(printf '%q' "${MAINT_MAX_DAYS}")
MAINT_LOGGING=$(printf '%q' "${MAINT_LOGGING}")
MAINT_EXTRA_CMD=$(printf '%q' "${MAINT_EXTRA_CMD}")
EOF
    chmod 600 "$NK_ENV"
}

