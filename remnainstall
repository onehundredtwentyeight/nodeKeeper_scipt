# 3x-ui Container Helpers (DB Readiness, CLI Execution, SSL & API Token)
# ==============================================================================
ensure_3xui_db_ready() {
    if [ "${XUI_DB_TYPE:-sqlite}" = "postgres" ] && [ -f "${XUI_DIR}/docker-compose.yml" ]; then
        info "Starting PostgreSQL container (3xui_postgres) and waiting for readiness..."
        (cd "$XUI_DIR" && docker compose up -d postgres)
        local attempt=0
        while [ "$attempt" -lt 25 ]; do
            if docker exec 3xui_postgres pg_isready -U xui -d xui >/dev/null 2>&1; then
                ok "PostgreSQL database is ready."
                return 0
            fi
            sleep 1
            attempt=$((attempt + 1))
        done
        warn "PostgreSQL readiness check timed out; proceeding anyway."
    fi
}

xui_cli() {
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx '3xui_app'; then
        docker exec 3xui_app /app/x-ui "$@"
    else
        ensure_3xui_db_ready
        (cd "$XUI_DIR" && docker compose run --rm --no-deps --entrypoint /app/x-ui 3xui "$@")
    fi
}

setup_3xui_ssl() {
    if [ "${XUI_SSL_MODE:-none}" = "none" ] || [ -z "${XUI_SSL_MODE:-}" ]; then
        xui_cli cert -reset >/dev/null 2>&1 || true
        return 0
    fi

    # Stop 3xui_app temporarily if running so standalone HTTP-01 challenge can bind port 80
    local was_running="false"
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx '3xui_app'; then
        was_running="true"
        info "Stopping 3xui_app temporarily to free port 80 for ACME HTTP-01 verification..."
        docker stop 3xui_app >/dev/null 2>&1 || true
    fi

    if command -v ufw >/dev/null 2>&1; then
        ufw allow 80/tcp comment 'HTTP' >/dev/null 2>&1 || true
    fi

    while true; do
        local target_host=""
        local cert_subdir=""
        local is_ip_cert="false"

        if [ "$XUI_SSL_MODE" = "domain" ]; then
            while [ -z "$XUI_SSL_DOMAIN" ]; do
                tty_read "Enter domain name for 3x-ui Panel SSL: " XUI_SSL_DOMAIN
            done
            target_host="$XUI_SSL_DOMAIN"
            cert_subdir="$XUI_SSL_DOMAIN"
        elif [ "$XUI_SSL_MODE" = "ip" ]; then
            target_host=$(get_public_ipv4)
            cert_subdir="ip"
            is_ip_cert="true"
        else
            break
        fi

        info "Requesting Let's Encrypt SSL certificate for '${target_host}' via acme.sh (port 80)..."
        mkdir -p "${XUI_DIR}/acme" "${XUI_DIR}/cert/${cert_subdir}"

        local acme_log
        acme_log=$(mktemp /tmp/nodekeeper-acme.XXXXXX)

        local acme_cmd=""
        if [ "$is_ip_cert" = "true" ]; then
            acme_cmd="set -e
if [ ! -f /root/.acme.sh/acme.sh ]; then
    curl -fsSL https://get.acme.sh | sh
fi
/root/.acme.sh/acme.sh --set-default-ca --server letsencrypt
/root/.acme.sh/acme.sh --issue -d '${target_host}' --standalone --server letsencrypt --certificate-profile shortlived --days 6 --httpport 80 --force
mkdir -p '/root/cert/${cert_subdir}'
/root/.acme.sh/acme.sh --install-cert -d '${target_host}' \
    --key-file '/root/cert/${cert_subdir}/privkey.pem' \
    --fullchain-file '/root/cert/${cert_subdir}/fullchain.pem' \
    --reloadcmd 'pkill -HUP x-ui || true'"
        else
            acme_cmd="set -e
if [ ! -f /root/.acme.sh/acme.sh ]; then
    curl -fsSL https://get.acme.sh | sh
fi
/root/.acme.sh/acme.sh --set-default-ca --server letsencrypt
/root/.acme.sh/acme.sh --issue -d '${target_host}' --standalone --httpport 80 --force
mkdir -p '/root/cert/${cert_subdir}'
/root/.acme.sh/acme.sh --install-cert -d '${target_host}' \
    --key-file '/root/cert/${cert_subdir}/privkey.pem' \
    --fullchain-file '/root/cert/${cert_subdir}/fullchain.pem' \
    --reloadcmd 'pkill -HUP x-ui || true'"
        fi

        if (cd "$XUI_DIR" && docker compose run --rm --no-deps --entrypoint /bin/sh 3xui -c "$acme_cmd") >"$acme_log" 2>&1 \
            && [ -s "${XUI_DIR}/cert/${cert_subdir}/fullchain.pem" ] \
            && [ -s "${XUI_DIR}/cert/${cert_subdir}/privkey.pem" ]; then
            rm -f "$acme_log"
            info "Binding SSL certificate to 3x-ui panel..."
            xui_cli cert -webCert "/root/cert/${cert_subdir}/fullchain.pem" -webCertKey "/root/cert/${cert_subdir}/privkey.pem"
            ok "SSL certificate issued and configured for '${target_host}' (/root/cert/${cert_subdir}/)."
            break
        fi

        echo -e "\n${C_RED}${C_BOLD}====================================================================${C_RESET}"
        err "SSL certificate issuance via acme.sh FAILED for '${target_host}'!"
        warn "Error log from acme.sh:"
        echo -e "${C_YELLOW}--------------------------------------------------------------------${C_RESET}"
        cat "$acme_log"
        echo -e "${C_YELLOW}--------------------------------------------------------------------${C_RESET}"
        rm -f "$acme_log"
        warn "Possible reasons: domain DNS A-record does not point to this server, port 80 is occupied or filtered by an upstream firewall, or Let's Encrypt rate limit reached."
        echo -e "${C_RED}${C_BOLD}====================================================================${C_RESET}\n"

        if [ "${UNATTENDED:-false}" = "true" ]; then
            warn "Unattended mode: falling back to HTTP mode (XUI_SSL_MODE=none) and updating nodeKeeper configuration."
            XUI_SSL_MODE="none"
            XUI_SSL_DOMAIN=""
            save_env
            xui_cli cert -reset >/dev/null 2>&1 || true
            break
        fi

        echo -e "${C_BOLD}Execution paused. How would you like to proceed?${C_RESET}"
        if [ "$XUI_SSL_MODE" = "domain" ]; then
            echo "  1) Try again (re-run acme.sh or enter a different domain)"
        else
            echo "  1) Try again (re-run acme.sh for IP ${target_host})"
        fi
        echo "  2) Continue with HTTP (disable SSL and update nodeKeeper configuration to HTTP mode)"

        local ssl_err_choice=""
        tty_read "Select option [1-2, default 2]: " ssl_err_choice "2"
        case "$ssl_err_choice" in
            1)
                if [ "$XUI_SSL_MODE" = "domain" ]; then
                    local new_dom=""
                    tty_read "Enter domain name to retry [Enter to keep '${XUI_SSL_DOMAIN}']: " new_dom "$XUI_SSL_DOMAIN"
                    XUI_SSL_DOMAIN="$new_dom"
                    save_env
                fi
                info "Retrying SSL certificate issuance..."
                ;;
            *)
                XUI_SSL_MODE="none"
                XUI_SSL_DOMAIN=""
                save_env
                xui_cli cert -reset >/dev/null 2>&1 || true
                warn "Switched 3x-ui panel to HTTP mode (XUI_SSL_MODE=none saved in nodeKeeper configuration)."
                break
                ;;
        esac
    done

    if [ "$was_running" = "true" ]; then
        (cd "$XUI_DIR" && docker compose up -d --remove-orphans)
    fi
}

mint_3xui_api_token() {
    local token_out api_token
    token_out=$(xui_cli setting -getApiToken 2>/dev/null || true)
    api_token=$(echo "$token_out" | awk '/^apiToken:/ {print $2; exit}')
    if [ -n "$api_token" ]; then
        (
            umask 077
            echo "$api_token" > "$NK_XUI_TOKEN_FILE"
            chmod 600 "$NK_XUI_TOKEN_FILE"
        )
        echo "$api_token"
        return 0
    fi
    return 1
}

cmd_xui_token() {
    if [ "$INSTALL_MODE" != "3xui" ]; then
        err "This node is not running in 3xui mode (current mode: ${INSTALL_MODE})."
        return 1
    fi
    info "Generating / rotating 3x-ui API key (token) for Central Panel..."
    local tok
    if tok=$(mint_3xui_api_token) && [ -n "$tok" ]; then
        rm -f "$NK_XUI_TOKEN_FILE"
        echo -e "\n${C_BOLD}====================================================================${C_RESET}"
        echo -e "${C_BOLD}            3x-ui Node API Key (for Central Panel)                  ${C_RESET}"
        echo -e "${C_BOLD}====================================================================${C_RESET}"
        echo -e "  Panel URL:   ${C_CYAN}$(xui_panel_url)${C_RESET}"
        echo -e "  API Key:     ${C_GREEN}${C_BOLD}${tok}${C_RESET}"
        echo -e "${C_BOLD}====================================================================${C_RESET}\n"
    else
        err "Failed to generate API token via '/app/x-ui setting -getApiToken'."
        return 1
    fi
}

init_3xui_settings() {
    local init_pass="${1:-}"
    if [ ! -f "${XUI_DIR}/docker-compose.yml" ]; then
        err "3x-ui compose file not found at ${XUI_DIR}/docker-compose.yml"
        return 1
    fi

    info "Pulling 3x-ui Docker image(s)..."
    (cd "$XUI_DIR" && docker compose pull)

    ensure_3xui_db_ready

    XUI_WEB_BASE_PATH=$(normalize_web_base_path "${XUI_WEB_BASE_PATH:-/}")
    save_env

    local -a setting_args=()
    [ -n "$XUI_USERNAME" ] && setting_args+=(-username "$XUI_USERNAME")
    [ -n "$init_pass" ] && setting_args+=(-password "$init_pass")
    [ -n "$XUI_PORT" ] && setting_args+=(-port "$XUI_PORT")
    [ -n "$XUI_WEB_BASE_PATH" ] && setting_args+=(-webBasePath "$XUI_WEB_BASE_PATH")

    if [ ${#setting_args[@]} -gt 0 ]; then
        info "Configuring 3x-ui panel credentials, port (${XUI_PORT}), and path (${XUI_WEB_BASE_PATH})..."
        if xui_cli setting "${setting_args[@]}"; then
            ok "3x-ui panel settings applied."
        else
            warn "3x-ui CLI setting command returned non-zero; verify credentials via 'nodeKeeper status'."
        fi
    fi

    # Configure SSL (domain / IP / HTTP)
    setup_3xui_ssl

    # Mint API key for central 3x-ui panel
    info "Generating 3x-ui API key for Central Panel integration..."
    if mint_3xui_api_token >/dev/null; then
        ok "3x-ui API key generated."
    else
        warn "Could not auto-generate 3x-ui API key; you can generate it anytime with 'nodeKeeper xui-token'."
    fi
}

# ==============================================================================
# Maintenance Script & Cron Management
# ==============================================================================
generate_maintenance_script() {
    mkdir -p "$NK_DIR" "$NK_LOG_DIR"
    cat > "$NK_MAINT_SCRIPT" <<'EOF'
#!/usr/bin/env bash
export DEBIAN_FRONTEND=noninteractive
NK_DIR="/opt/nodekeeper"
NK_ENV="${NK_DIR}/nodekeeper.env"
LOG_DIR="${NK_DIR}/logs"
mkdir -p "$LOG_DIR"

if [ -f "$NK_ENV" ]; then
    source "$NK_ENV"
fi

MAINT_MIN_DAYS="${MAINT_MIN_DAYS:-5}"
MAINT_MAX_DAYS="${MAINT_MAX_DAYS:-10}"
MAINT_LOGGING="${MAINT_LOGGING:-true}"
MAINT_EXTRA_CMD="${MAINT_EXTRA_CMD:-}"

if [ "${INSTALL_MODE:-basic}" = "3xui" ]; then
    COMPOSE_DIR="/opt/3x-ui"
else
    COMPOSE_DIR="/opt/remnanode"
fi

DATE=$(date +%Y-%m-%d_%H-%M)
if [ "$MAINT_LOGGING" = "true" ]; then
    LOG_FILE="${LOG_DIR}/update_${DATE}.log"
    TEST_LOG="${LOG_DIR}/tests_${DATE}.log"
else
    LOG_FILE="/dev/null"
    TEST_LOG="/dev/null"
fi

{
    echo "=== Maintenance started: $DATE ==="
    if [ -d "$COMPOSE_DIR" ] && [ -f "${COMPOSE_DIR}/docker-compose.yml" ]; then
        cd "$COMPOSE_DIR" && /usr/bin/docker compose pull
    fi
    /usr/bin/apt-get update && /usr/bin/apt-get upgrade -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold"
    if [ -d "$COMPOSE_DIR" ] && [ -f "${COMPOSE_DIR}/docker-compose.yml" ] && [ "${SERVER_DISABLED:-false}" != "true" ]; then
        if [ "${INSTALL_MODE:-basic}" = "3xui" ]; then
            cd "$COMPOSE_DIR" && /usr/bin/docker compose up -d
        else
            cd "$COMPOSE_DIR" && /usr/bin/docker compose up -d --build
        fi
    fi
    if [ -n "$MAINT_EXTRA_CMD" ]; then
        echo "--- Running custom command: $MAINT_EXTRA_CMD ---"
        eval "$MAINT_EXTRA_CMD"
    fi
    echo "=== Maintenance completed ==="
} >> "$LOG_FILE" 2>&1

if [ "$MAINT_LOGGING" = "true" ]; then
    {
        echo "=== Diagnostics: $DATE ==="
        wget -qO - "https://raw.githubusercontent.com/vernette/ipregion/refs/heads/master/ipregion.sh" | bash
        wget -qO - "https://github.com/vernette/censorcheck/raw/master/censorcheck.sh" | bash
    } >> "$TEST_LOG" 2>&1

    find "$LOG_DIR" -type f -name "*.log" ! -name "autoupdate.log" -mtime +30 -delete 2>/dev/null || true
fi

# Schedule next run
SPAN=$(( MAINT_MAX_DAYS - MAINT_MIN_DAYS + 1 ))
[ "$SPAN" -lt 1 ] && SPAN=1
NEXT_DAYS=$(( ( RANDOM % SPAN ) + MAINT_MIN_DAYS ))
NEXT_HOUR=$(( RANDOM % 24 ))
NEXT_MIN=$(( RANDOM % 60 ))
NEXT_DATE=$(date -d "+${NEXT_DAYS} days" +%d)
NEXT_MONTH=$(date -d "+${NEXT_DAYS} days" +%m)

CRON_JOB="${NEXT_MIN} ${NEXT_HOUR} ${NEXT_DATE} ${NEXT_MONTH} * /bin/bash ${NK_DIR}/maintenance.sh"
(crontab -l 2>/dev/null | grep -v "maintenance.sh"; echo "$CRON_JOB") | crontab -

sleep 10
/usr/sbin/reboot
EOF
    chmod +x "$NK_MAINT_SCRIPT"
}

schedule_enable() {
    generate_maintenance_script
    local span=$(( MAINT_MAX_DAYS - MAINT_MIN_DAYS + 1 ))
    [ "$span" -lt 1 ] && span=1
    local next_days=$(( ( RANDOM % span ) + MAINT_MIN_DAYS ))
    local h=$(( RANDOM % 24 ))
    local m=$(( RANDOM % 60 ))
    local d mon
    d=$(date -d "+${next_days} days" +%d 2>/dev/null || date +%d)
    mon=$(date -d "+${next_days} days" +%m 2>/dev/null || date +%m)
    local job="${m} ${h} ${d} ${mon} * /bin/bash ${NK_MAINT_SCRIPT}"
    (crontab -l 2>/dev/null | grep -v "maintenance.sh"; echo "$job") | crontab -
    MAINT_ENABLED="true"
    save_env
    ok "Maintenance schedule ENABLED (Next run in ~${next_days} days: ${d}.${mon} at $(printf '%02d:%02d' "$h" "$m"))."
}

schedule_disable() {
    (crontab -l 2>/dev/null | grep -v "maintenance.sh") | crontab - 2>/dev/null || true
    MAINT_ENABLED="false"
    save_env
    ok "Maintenance schedule DISABLED."
}

schedule_status() {
    echo -e "${C_BOLD}--- Maintenance Schedule Status ---${C_RESET}"
    echo -e "Enabled:           ${C_CYAN}${MAINT_ENABLED}${C_RESET}"
    echo -e "Interval Range:    ${C_CYAN}${MAINT_MIN_DAYS}-${MAINT_MAX_DAYS} days${C_RESET}"
    echo -e "Logging Enabled:   ${C_CYAN}${MAINT_LOGGING}${C_RESET} (${NK_LOG_DIR})"
    echo -e "Extra Command:     ${C_CYAN}${MAINT_EXTRA_CMD:-<none>}${C_RESET}"
    local cron_line
    cron_line=$(crontab -l 2>/dev/null | grep "maintenance.sh" || true)
    if [ -n "$cron_line" ]; then
        echo -e "Active Crontab:    ${C_GREEN}${cron_line}${C_RESET}"
    else
        echo -e "Active Crontab:    ${C_YELLOW}Not scheduled${C_RESET}"
    fi
}

# ==============================================================================
# Auto-Update Subsystem
# ==============================================================================
autoupdate_enable() {
    local keep_existing="${1:-false}"
    mkdir -p "$NK_LOG_DIR"
    local existing_line
    existing_line=$(crontab -l 2>/dev/null | grep "nodeKeeper update --auto" || true)

    if [ "$keep_existing" = "true" ] && [ -n "$existing_line" ]; then
        AUTO_UPDATE_ENABLED="true"
        save_env
        ok "Auto-update cron already configured: ${existing_line}"
        return 0
    fi

    local h=$(( RANDOM % 6 ))
    local m=$(( RANDOM % 60 ))
    local job="${m} ${h} * * * /usr/local/bin/nodeKeeper update --auto >> ${NK_AUTOUPDATE_LOG} 2>&1"
    (crontab -l 2>/dev/null | grep -v "nodeKeeper update --auto"; echo "$job") | crontab -
    AUTO_UPDATE_ENABLED="true"
    save_env
    ok "Auto-update cron ENABLED (daily at $(printf '%02d:%02d' "$h" "$m"))."
}

autoupdate_disable() {
    (crontab -l 2>/dev/null | grep -v "nodeKeeper update --auto") | crontab - 2>/dev/null || true
    AUTO_UPDATE_ENABLED="false"
    save_env
    ok "Auto-update cron DISABLED."
}

autoupdate_status() {
    echo -e "${C_BOLD}--- Auto-Update Status ---${C_RESET}"
    echo -e "Installed Version: ${C_CYAN}${NK_VERSION}${C_RESET}"
    echo -e "Auto-Update Cron:  ${C_CYAN}${AUTO_UPDATE_ENABLED}${C_RESET}"
    echo -e "Repository URL:    ${C_CYAN}${NK_REPO_RAW_URL}${C_RESET}"
    local cron_line
    cron_line=$(crontab -l 2>/dev/null | grep "nodeKeeper update --auto" || true)
    if [ -n "$cron_line" ]; then
        echo -e "Active Crontab:    ${C_GREEN}${cron_line}${C_RESET}"
    else
        echo -e "Active Crontab:    ${C_YELLOW}Not scheduled${C_RESET}"
    fi
}

cmd_update() {
    local action="${1:-now}"
    case "$action" in
        enable)
            autoupdate_enable "${2:-false}"
            return 0
            ;;
        disable)
            autoupdate_disable
            return 0
            ;;
        status)
            autoupdate_status
            return 0
            ;;
        check|now|--auto)
            ;;
        *)
            err "Unknown update action: $action (use: check | now | enable | disable | status)"
            return 1
            ;;
    esac

    local lock_file="/run/nodekeeper-update.lock"
    [ ! -d /run ] && lock_file="/tmp/nodekeeper-update.lock"
    if [ -f "$lock_file" ]; then
        local lock_pid
        lock_pid=$(cat "$lock_file" 2>/dev/null || true)
        if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
            warn "Another nodeKeeper update process is already running (PID ${lock_pid})."
            return 0
        fi
    fi
    echo $$ > "$lock_file"

    local tmp_installer
    tmp_installer=$(mktemp /tmp/nodekeeper-installer.XXXXXX)
    cleanup_update_tmp() {
        rm -f "$tmp_installer" "$lock_file"
    }
    trap cleanup_update_tmp RETURN

    local ts
    ts=$(date '+%Y-%m-%d %H:%M:%S')
    [ "$action" = "--auto" ] && echo "=== [${ts}] nodeKeeper Auto-Update Check (current: v${NK_VERSION}) ==="

    local installer_url="${NK_REPO_RAW_URL%/}/install.sh"
    if ! curl -fsSL --connect-timeout 10 --max-time 30 "$installer_url" -o "$tmp_installer"; then
        err "Failed to download ${installer_url}"
        return 1
    fi

    if ! bash -n "$tmp_installer" 2>/dev/null; then
        err "Downloaded installer failed bash syntax validation; aborting update."
        return 1
    fi

    local remote_ver
    remote_ver=$(grep -m1 '^INSTALLER_VERSION=' "$tmp_installer" | sed -E 's/^INSTALLER_VERSION="?([^"#[:space:]]+)"?.*/\1/' || true)
    if [[ ! "$remote_ver" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
        err "Invalid remote version string '${remote_ver}'; aborting update."
        return 1
    fi

    if version_gt "$remote_ver" "$NK_VERSION"; then
        info "New nodeKeeper version available: v${remote_ver} (installed: v${NK_VERSION})."
        if [ "$action" = "check" ]; then
            info "Run 'nodeKeeper update now' to install v${remote_ver}."
            return 0
        fi
        info "Installing nodeKeeper v${remote_ver}..."
        bash "$tmp_installer" --update --yes
        local rc=$?
        if [ $rc -eq 0 ]; then
            ok "Updated nodeKeeper from v${NK_VERSION} to v${remote_ver}."
        else
            err "Update to v${remote_ver} failed (exit code ${rc})."
        fi
        return $rc
    else
        ok "nodeKeeper is up to date (installed: v${NK_VERSION}, remote: v${remote_ver})."
        return 0
    fi
}

# ==============================================================================
# Service & Mode Controls
# ==============================================================================
apply_firewall() {
    if ! command -v ufw >/dev/null 2>&1; then
        return 0
    fi
    ufw allow "${SSH_PORT}/tcp" comment 'SSH' >/dev/null 2>&1 || true

    if [ "$SERVER_DISABLED" = "true" ]; then
        ufw delete allow 80/tcp >/dev/null 2>&1 || true
        ufw delete allow 443/tcp >/dev/null 2>&1 || true
        ufw delete allow 443/udp >/dev/null 2>&1 || true
        [ -n "$XUI_PORT" ] && ufw delete allow "${XUI_PORT}/tcp" >/dev/null 2>&1 || true
        if [ -n "$PANEL_IP" ]; then
            [ -n "$NODE_PORT" ] && ufw delete allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp >/dev/null 2>&1 || true
            [ -n "$XUI_PORT" ] && ufw delete allow from "$PANEL_IP" to any port "$XUI_PORT" proto tcp >/dev/null 2>&1 || true
        fi
    else
        ufw allow 80/tcp comment 'HTTP' >/dev/null 2>&1 || true
        ufw allow 443/tcp comment 'HTTPS-REALITY' >/dev/null 2>&1 || true
        ufw allow 443/udp comment 'QUIC-Hysteria' >/dev/null 2>&1 || true
        if [ "$INSTALL_MODE" = "3xui" ]; then
            if [ -n "$PANEL_IP" ] && [ -n "$NODE_PORT" ] && [ "$NODE_PORT" != "$XUI_PORT" ]; then
                ufw delete allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp >/dev/null 2>&1 || true
            fi
            if [ -n "$XUI_PORT" ]; then
                if [ -n "$PANEL_IP" ]; then
                    ufw delete allow "${XUI_PORT}/tcp" >/dev/null 2>&1 || true
                    ufw allow from "$PANEL_IP" to any port "$XUI_PORT" proto tcp comment '3x-ui-Panel' >/dev/null 2>&1 || true
                else
                    ufw allow "${XUI_PORT}/tcp" comment '3x-ui-Panel' >/dev/null 2>&1 || true
                fi
            fi
        else
            if [ -n "$XUI_PORT" ] && [ "$XUI_PORT" != "$NODE_PORT" ]; then
                ufw delete allow "${XUI_PORT}/tcp" >/dev/null 2>&1 || true
                if [ -n "$PANEL_IP" ]; then
                    ufw delete allow from "$PANEL_IP" to any port "$XUI_PORT" proto tcp >/dev/null 2>&1 || true
                fi
            fi
            if [ -n "$PANEL_IP" ] && [ -n "$NODE_PORT" ]; then
                ufw allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp comment 'Remnawave-Panel' >/dev/null 2>&1 || true
            fi
        fi
    fi
    ufw reload >/dev/null 2>&1 || true
}

