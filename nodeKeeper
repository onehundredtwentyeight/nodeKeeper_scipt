cmd_start() {
    local cdir
    cdir=$(active_compose_dir)
    SERVER_DISABLED="false"
    save_env
    apply_firewall
    if [ -f "${cdir}/docker-compose.yml" ]; then
        info "Starting containers in ${cdir}..."
        if [ "$INSTALL_MODE" = "3xui" ]; then
            (cd "$cdir" && docker compose up -d --remove-orphans)
        else
            (cd "$cdir" && docker compose up -d --build --remove-orphans)
        fi
        ok "Node services started."
    else
        err "Compose file not found at ${cdir}/docker-compose.yml"
    fi
}

cmd_stop() {
    local cdir
    cdir=$(active_compose_dir)
    if [ -f "${cdir}/docker-compose.yml" ]; then
        info "Stopping containers in ${cdir}..."
        (cd "$cdir" && docker compose down)
        ok "Node services stopped."
    fi
}

cmd_restart() {
    local cdir
    cdir=$(active_compose_dir)
    if [ -f "${cdir}/docker-compose.yml" ]; then
        info "Restarting containers in ${cdir}..."
        if [ "$INSTALL_MODE" = "3xui" ]; then
            (cd "$cdir" && docker compose down && docker compose up -d --remove-orphans)
        else
            (cd "$cdir" && docker compose down && docker compose up -d --build --remove-orphans)
        fi
        ok "Node services restarted."
    fi
}

cmd_disable_server() {
    warn "Disabling node services and closing proxy firewall ports..."
    cmd_stop
    SERVER_DISABLED="true"
    save_env
    apply_firewall
    ok "Server is now DISABLED. Run 'nodeKeeper enable' to re-enable."
}

cmd_enable_server() {
    info "Re-enabling node services and restoring firewall rules..."
    cmd_start
    ok "Server is now ENABLED."
}

cmd_switch_mode() {
    local target_mode="${1:-}"
    if [ -z "$target_mode" ]; then
        echo -e "\n${C_BOLD}Select Installation Mode:${C_RESET}"
        echo "  1) basic            — Remnanode only (no Caddy)"
        echo "  2) selfsteal-single — Remnanode + Caddy (one server per domain)"
        echo "  3) selfsteal-multi  — Remnanode + Caddy with Cloudflare DNS plugin (multi-server)"
        echo "  4) 3xui             — 3x-ui Panel in Docker container"
        read -rp "Enter choice [1-4]: " m_choice
        case "$m_choice" in
            1) target_mode="basic" ;;
            2) target_mode="selfsteal-single" ;;
            3) target_mode="selfsteal-multi" ;;
            4) target_mode="3xui" ;;
            *) err "Invalid selection."; return 1 ;;
        esac
    fi

    local xui_pass="${XUI_INIT_PASSWORD:-}"

    case "$target_mode" in
        1|basic|no-caddy)
            target_mode="basic"
            if [ -z "$SECRET_KEY" ]; then
                read -rp "Paste Remnanode SECRET_KEY: " SECRET_KEY
            fi
            ;;
        2|selfsteal-single|single|selfsteal)
            target_mode="selfsteal-single"
            if [ -z "$SELF_STEAL_DOMAIN" ]; then
                read -rp "Enter Selfsteal Domain (e.g. node.example.com): " SELF_STEAL_DOMAIN
            fi
            if [ -z "$SECRET_KEY" ]; then
                read -rp "Paste Remnanode SECRET_KEY: " SECRET_KEY
            fi
            ;;
        3|selfsteal-multi|multi|cloudflare)
            target_mode="selfsteal-multi"
            if [ -z "$SELF_STEAL_DOMAIN" ]; then
                read -rp "Enter Selfsteal Domain (e.g. node.example.com): " SELF_STEAL_DOMAIN
            fi
            if [ -z "$CLOUDFLARE_API_TOKEN" ]; then
                read -rp "Enter Cloudflare API Token (DNS Edit permission): " CLOUDFLARE_API_TOKEN
            fi
            if [ -z "$SECRET_KEY" ]; then
                read -rp "Paste Remnanode SECRET_KEY: " SECRET_KEY
            fi
            ;;
        4|3xui|3x-ui|xui|x-ui)
            target_mode="3xui"
            if [ -z "$XUI_USERNAME" ]; then
                local def_u
                def_u=$(generate_xui_username)
                read -rp "Enter 3x-ui Panel username [default: ${def_u}]: " XUI_USERNAME
                XUI_USERNAME="${XUI_USERNAME:-$def_u}"
            fi
            if [ -z "$xui_pass" ] && [ ! -f "${XUI_DIR}/db/x-ui.db" ]; then
                local def_p
                def_p=$(generate_password)
                read -rp "Enter 3x-ui Panel password [default: ${def_p}]: " xui_pass
                xui_pass="${xui_pass:-$def_p}"
            fi
            if [ -z "$XUI_PORT" ]; then
                local def_port
                def_port=$(generate_xui_port)
                read -rp "Enter 3x-ui Panel port [default: ${def_port}]: " XUI_PORT
                XUI_PORT="${XUI_PORT:-$def_port}"
            fi
            while ! validate_ipv4 "$PANEL_IP"; do
                read -rp "Enter Main/Central Node IPv4 address (for 3x-ui panel port whitelist): " PANEL_IP
                validate_ipv4 "$PANEL_IP" || warn "Invalid IPv4 address format."
            done
            ;;
        *)
            err "Invalid mode '$target_mode'. Use: basic | selfsteal-single | selfsteal-multi | 3xui"
            return 1
            ;;
    esac

    info "Switching mode to: ${target_mode}..."

    # Stop any previously running stack
    if [ -f "${REMNA_DIR}/docker-compose.yml" ]; then
        (cd "$REMNA_DIR" && docker compose down --remove-orphans) || true
    fi
    if [ -f "${XUI_DIR}/docker-compose.yml" ]; then
        (cd "$XUI_DIR" && docker compose down --remove-orphans) || true
    fi

    INSTALL_MODE="$target_mode"
    save_env
    write_mode_configs "$INSTALL_MODE"
    apply_firewall

    if [ "$INSTALL_MODE" = "3xui" ]; then
        if [ ! -f "${XUI_DIR}/db/x-ui.db" ] || [ -n "$xui_pass" ]; then
            init_3xui_settings "$xui_pass"
        fi
        (cd "$XUI_DIR" && docker compose up -d --remove-orphans)
        fix_service_dir_permissions
        ok "Successfully switched to mode: 3xui"
        if [ "${NK_FROM_INSTALLER:-false}" != "true" ]; then
            local pub_ip
            pub_ip=$(curl -4 -fsSL --connect-timeout 5 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}')
            echo -e "\n${C_BOLD}--- 3x-ui Panel Access Details ---${C_RESET}"
            echo -e "  URL:          ${C_CYAN}http://${pub_ip}:${XUI_PORT}${XUI_WEB_BASE_PATH:-/}${C_RESET}"
            echo -e "  Port:         ${C_CYAN}${XUI_PORT}${C_RESET} (Whitelisted IP: ${PANEL_IP})"
            echo -e "  Username:     ${C_GREEN}${XUI_USERNAME}${C_RESET}"
            [ -n "$xui_pass" ] && echo -e "  Password:     ${C_YELLOW}${xui_pass}${C_RESET}"
        fi
    else
        (cd "$REMNA_DIR" && docker compose up -d --build --remove-orphans)
        fix_service_dir_permissions
        ok "Successfully switched to mode: ${INSTALL_MODE}"
    fi
}

cmd_uninstall() {
    local force="${1:-false}"
    if [ "$force" != "--yes" ]; then
        echo -e "${C_RED}${C_BOLD}WARNING: This will completely uninstall Remnanode/Caddy/3x-ui, maintenance & auto-update cron jobs, and nodeKeeper configurations!${C_RESET}"
        read -rp "Type 'UNINSTALL' to confirm: " confirm
        if [ "$confirm" != "UNINSTALL" ]; then
            info "Uninstall cancelled."
            return 0
        fi
    fi

    info "Stopping and removing Docker containers, volumes, and images..."
    if [ -d "$REMNA_DIR" ] && [ -f "${REMNA_DIR}/docker-compose.yml" ]; then
        (cd "$REMNA_DIR" && docker compose down -v --rmi local --remove-orphans) || true
    fi
    rm -rf "$REMNA_DIR"

    if [ -d "$XUI_DIR" ] && [ -f "${XUI_DIR}/docker-compose.yml" ]; then
        (cd "$XUI_DIR" && docker compose down -v --rmi local --remove-orphans) || true
    fi
    rm -rf "$XUI_DIR"

    info "Removing maintenance and auto-update schedules..."
    (crontab -l 2>/dev/null | grep -v "maintenance.sh" | grep -v "nodeKeeper update --auto") | crontab - 2>/dev/null || true

    info "Stopping WARP interface if present..."
    systemctl disable --now wg-quick@warp >/dev/null 2>&1 || true
    rm -f /etc/wireguard/warp.conf

    info "Cleaning up firewall rules..."
    if command -v ufw >/dev/null 2>&1; then
        ufw delete allow 80/tcp >/dev/null 2>&1 || true
        ufw delete allow 443/tcp >/dev/null 2>&1 || true
        ufw delete allow 443/udp >/dev/null 2>&1 || true
        if [ -n "$PANEL_IP" ]; then
            [ -n "$NODE_PORT" ] && ufw delete allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp >/dev/null 2>&1 || true
            [ -n "$XUI_PORT" ] && ufw delete allow from "$PANEL_IP" to any port "$XUI_PORT" proto tcp >/dev/null 2>&1 || true
        fi
        ufw reload >/dev/null 2>&1 || true
    fi

    info "Removing nodeKeeper files..."
    rm -rf "$NK_DIR"
    sed -i '/alias nodeKeeper=/d' /root/.bashrc 2>/dev/null || true
    if [ -n "$ADMIN_USER" ] && [ -f "/home/${ADMIN_USER}/.bashrc" ]; then
        sed -i '/alias nodeKeeper=/d' "/home/${ADMIN_USER}/.bashrc" 2>/dev/null || true
    fi
    rm -f /usr/local/bin/nodeKeeper /usr/local/bin/nodekeeper

    ok "Full uninstallation complete."
}

