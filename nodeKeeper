menu_schedule() {
    while true; do
        echo -e "\n${C_BOLD}=== Maintenance Schedule Control ===${C_RESET}"
        schedule_status
        echo ""
        echo "  1) Enable Maintenance Schedule"
        echo "  2) Disable Maintenance Schedule"
        echo "  3) Change Frequency Range (current: ${MAINT_MIN_DAYS}-${MAINT_MAX_DAYS} days)"
        echo "  4) Toggle Logging (current: ${MAINT_LOGGING})"
        echo "  5) Set Additional Custom Command"
        echo "  6) Run Maintenance Now (Warning: will reboot server!)"
        echo "  0) Back"
        read -rp "Select option: " s_opt
        case "$s_opt" in
            1) schedule_enable ;;
            2) schedule_disable ;;
            3)
                read -rp "Enter minimum days between runs [default 5]: " min_d
                read -rp "Enter maximum days between runs [default 10]: " max_d
                MAINT_MIN_DAYS="${min_d:-5}"
                MAINT_MAX_DAYS="${max_d:-10}"
                if [ "$MAINT_MAX_DAYS" -lt "$MAINT_MIN_DAYS" ]; then
                    MAINT_MAX_DAYS="$MAINT_MIN_DAYS"
                fi
                save_env
                [ "$MAINT_ENABLED" = "true" ] && schedule_enable
                ;;
            4)
                if [ "$MAINT_LOGGING" = "true" ]; then
                    MAINT_LOGGING="false"
                else
                    MAINT_LOGGING="true"
                fi
                save_env
                generate_maintenance_script
                ok "Maintenance logging set to: ${MAINT_LOGGING}"
                ;;
            5)
                echo "Current extra command: ${MAINT_EXTRA_CMD:-<none>}"
                read -rp "Enter custom command to run during maintenance (leave empty to clear): " extra_c
                MAINT_EXTRA_CMD="$extra_c"
                save_env
                generate_maintenance_script
                ok "Custom maintenance command updated."
                ;;
            6)
                read -rp "Run maintenance now? Server will reboot upon completion! [y/N]: " r_conf
                if [[ "$r_conf" =~ ^[Yy]$ ]]; then
                    generate_maintenance_script
                    bash "$NK_MAINT_SCRIPT"
                fi
                ;;
            0) break ;;
            *) warn "Invalid choice." ;;
        esac
    done
}

menu_configs() {
    while true; do
        echo -e "\n${C_BOLD}=== Node Configuration Parameters ===${C_RESET}"
        echo "  1) Change Selfsteal Domain     (current: ${SELF_STEAL_DOMAIN:-<none>})"
        echo "  2) Change Cloudflare API Token (current: ${CLOUDFLARE_API_TOKEN:+***set***})"
        echo "  3) Change Panel IP             (current: ${PANEL_IP:-<none>})"
        echo "  4) Change Node Port            (current: ${NODE_PORT})"
        echo "  5) Update Remnanode SECRET_KEY"
        echo "  6) Change Hostname             (current: $(hostname))"
        echo "  7) Restart WARP Interface"
        echo "  0) Back"
        read -rp "Select option: " c_opt
        case "$c_opt" in
            1)
                read -rp "Enter new Selfsteal Domain: " new_dom
                if [ -n "$new_dom" ]; then
                    SELF_STEAL_DOMAIN="$new_dom"
                    save_env
                    write_mode_configs "$INSTALL_MODE"
                    cmd_restart
                fi
                ;;
            2)
                read -rp "Enter new Cloudflare API Token: " new_cf
                if [ -n "$new_cf" ]; then
                    CLOUDFLARE_API_TOKEN="$new_cf"
                    save_env
                    write_mode_configs "$INSTALL_MODE"
                    cmd_restart
                fi
                ;;
            3)
                read -rp "Enter new Panel IP: " new_pip
                if [ -n "$new_pip" ]; then
                    if command -v ufw >/dev/null 2>&1 && [ -n "$PANEL_IP" ]; then
                        ufw delete allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp >/dev/null 2>&1 || true
                    fi
                    PANEL_IP="$new_pip"
                    save_env
                    apply_firewall
                    ok "Panel IP updated to ${PANEL_IP}."
                fi
                ;;
            4)
                read -rp "Enter new Node Port [default 2222]: " new_port
                if [ -n "$new_port" ]; then
                    if command -v ufw >/dev/null 2>&1 && [ -n "$PANEL_IP" ]; then
                        ufw delete allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp >/dev/null 2>&1 || true
                    fi
                    NODE_PORT="$new_port"
                    save_env
                    write_mode_configs "$INSTALL_MODE"
                    apply_firewall
                    cmd_restart
                fi
                ;;
            5)
                read -rp "Paste new SECRET_KEY: " new_sk
                if [ -n "$new_sk" ]; then
                    SECRET_KEY="$new_sk"
                    save_env
                    write_mode_configs "$INSTALL_MODE"
                    cmd_restart
                fi
                ;;
            6)
                read -rp "Enter new full hostname: " new_hn
                if [ -n "$new_hn" ]; then
                    hostnamectl set-hostname "$new_hn"
                    NODE_HOSTNAME="$new_hn"
                    save_env
                    ok "Hostname updated to ${NODE_HOSTNAME}."
                fi
                ;;
            7)
                systemctl restart wg-quick@warp && ok "WARP restarted." || err "Failed to restart WARP."
                ;;
            0) break ;;
            *) warn "Invalid option." ;;
        esac
    done
}

menu_logs() {
    echo -e "\n${C_BOLD}=== Logs Viewer ===${C_RESET}"
    echo "  1) Remnanode Container Logs (last 100 lines)"
    echo "  2) Caddy Container Logs (last 100 lines)"
    echo "  3) List Maintenance Logs in ${NK_LOG_DIR}"
    echo "  4) View Latest Maintenance Log"
    echo "  5) View Latest Diagnostics / Censorcheck Log"
    echo "  0) Back"
    read -rp "Select option: " l_opt
    case "$l_opt" in
        1) docker logs --tail 100 remnanode 2>&1 || warn "remnanode container not found." ;;
        2) docker logs --tail 100 caddy-remnawave 2>&1 || warn "caddy-remnawave container not found." ;;
        3) ls -lh "$NK_LOG_DIR" 2>/dev/null || info "No logs directory." ;;
        4)
            local latest_u
            latest_u=$(ls -t "${NK_LOG_DIR}"/update_*.log 2>/dev/null | head -n1 || true)
            [ -n "$latest_u" ] && cat "$latest_u" || info "No maintenance update logs found."
            ;;
        5)
            local latest_t
            latest_t=$(ls -t "${NK_LOG_DIR}"/tests_*.log 2>/dev/null | head -n1 || true)
            [ -n "$latest_t" ] && cat "$latest_t" || info "No diagnostic test logs found."
            ;;
        0) return ;;
    esac
}

interactive_menu() {
    while true; do
        echo -e "\n${C_BOLD}╭──────────────────────────────────────────────────────────╮${C_RESET}"
        echo -e "${C_BOLD}│              nodeKeeper v${NK_VERSION} — Control Panel           │${C_RESET}"
        echo -e "${C_BOLD}╰──────────────────────────────────────────────────────────╯${C_RESET}"
        echo -e "  Host: ${C_CYAN}$(hostname)${C_RESET} | Mode: ${C_CYAN}${INSTALL_MODE}${C_RESET} | Disabled: ${C_CYAN}${SERVER_DISABLED}${C_RESET}"
        echo ""
        echo "  1) Status & Overview"
        echo "  2) Maintenance Schedule (Enable/Disable, Frequency, Logs, Hooks)"
        echo "  3) Change Install Mode (basic / selfsteal-single / selfsteal-multi)"
        echo "  4) Restart Services (Remnanode & Caddy)"
        echo "  5) Disable / Enable Server"
        echo "  6) Edit Configurations (Domain, CF Token, Panel IP, Secret Key)"
        echo "  7) View Logs"
        echo "  8) Full Uninstall"
        echo "  0) Exit"
        echo ""
        read -rp "Choose option [0-8]: " choice
        case "$choice" in
            1) cmd_status ;;
            2) menu_schedule ;;
            3) cmd_switch_mode ;;
            4) cmd_restart ;;
            5)
                if [ "$SERVER_DISABLED" = "true" ]; then
                    cmd_enable_server
                else
                    cmd_disable_server
                fi
                ;;
            6) menu_configs ;;
            7) menu_logs ;;
            8) cmd_uninstall; exit 0 ;;
            0) exit 0 ;;
            *) warn "Invalid option." ;;
        esac
    done
}

show_help() {
    cat <<EOF
nodeKeeper v${NK_VERSION} — Remnawave Node Management Utility

Usage:
  nodeKeeper                              Open interactive management menu
  nodeKeeper status                       Show node, container, WARP, and schedule status
  nodeKeeper start | stop | restart       Control Remnanode & Caddy containers
  nodeKeeper mode [basic|selfsteal-single|selfsteal-multi]
                                          Switch installation mode
  nodeKeeper schedule [enable|disable|status|freq <min> <max>|logs <true|false>|extra-cmd "<cmd>"]
                                          Control automated OS & container maintenance schedule
  nodeKeeper disable                      Stop node services and close proxy ports
  nodeKeeper enable                       Start node services and open proxy ports
  nodeKeeper logs [remnanode|caddy|maint|tests]
                                          View logs
  nodeKeeper uninstall [--yes]            Completely remove Remnanode, Caddy, cron, and configs
EOF
}

# ==============================================================================
# Entrypoint
# ==============================================================================
if [[ "${1:-}" =~ ^(-h|--help|help)$ ]]; then
    show_help
    exit 0
fi

ensure_root "$@"
load_env

SUBCMD="${1:-menu}"
shift || true

case "$SUBCMD" in
    menu)       interactive_menu ;;
    status)     cmd_status ;;
    start)      cmd_start ;;
    stop)       cmd_stop ;;
    restart)    cmd_restart ;;
    disable)    cmd_disable_server ;;
    enable)     cmd_enable_server ;;
    mode)       cmd_switch_mode "${1:-}" ;;
    schedule)
        S_ACT="${1:-status}"
        case "$S_ACT" in
            enable)  schedule_enable ;;
            disable) schedule_disable ;;
            status)  schedule_status ;;
            freq)
                MAINT_MIN_DAYS="${2:-5}"
                MAINT_MAX_DAYS="${3:-10}"
                save_env
                [ "$MAINT_ENABLED" = "true" ] && schedule_enable
                ;;
            logs)
                MAINT_LOGGING="${2:-true}"
                save_env
                generate_maintenance_script
                ok "Maintenance logging set to ${MAINT_LOGGING}"
                ;;
            extra-cmd)
                MAINT_EXTRA_CMD="${2:-}"
                save_env
                generate_maintenance_script
                ok "Extra command set to: ${MAINT_EXTRA_CMD}"
                ;;
            *) err "Unknown schedule action: $S_ACT"; show_help; exit 1 ;;
        esac
        ;;
    logs)
        L_TYPE="${1:-remnanode}"
        case "$L_TYPE" in
            remnanode) docker logs --tail 100 remnanode ;;
            caddy)     docker logs --tail 100 caddy-remnawave ;;
            maint)     cat "$(ls -t "${NK_LOG_DIR}"/update_*.log 2>/dev/null | head -n1)" ;;
            tests)     cat "$(ls -t "${NK_LOG_DIR}"/tests_*.log 2>/dev/null | head -n1)" ;;
            *)         menu_logs ;;
        esac
        ;;
    uninstall)  cmd_uninstall "${1:-}" ;;
    -h|--help|help) show_help ;;
    *)          err "Unknown command: $SUBCMD"; show_help; exit 1 ;;
esac
