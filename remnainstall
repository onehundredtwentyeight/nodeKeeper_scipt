# ==============================================================================
# Step 8: Deploy Service Stack (Remnanode or 3x-ui), Firewall & Cron Schedules
# ==============================================================================
deploy_remnanode_and_schedule() {
    step "7/8 Deploying ${INSTALL_MODE} Stack & Configuring Firewall"

    # Configure UFW
    info "Configuring UFW firewall rules..."
    ufw default deny incoming >/dev/null 2>&1 || true
    ufw default allow outgoing >/dev/null 2>&1 || true
    ufw allow "${SSH_PORT}/tcp" comment 'SSH' >/dev/null 2>&1 || true
    ufw allow 80/tcp comment 'HTTP' >/dev/null 2>&1 || true
    ufw allow 443/tcp comment 'HTTPS-REALITY' >/dev/null 2>&1 || true
    ufw allow 443/udp comment 'QUIC-Hysteria' >/dev/null 2>&1 || true

    if [ "$INSTALL_MODE" = "3xui" ]; then
        if [ -n "$XUI_PORT" ]; then
            if [ -n "$PANEL_IP" ]; then
                ufw allow from "$PANEL_IP" to any port "$XUI_PORT" proto tcp comment '3x-ui-Panel' >/dev/null 2>&1 || true
                ufw --force enable >/dev/null 2>&1 || true
                ok "UFW firewall enabled (SSH:${SSH_PORT}, 80, 443, and 3x-ui port ${XUI_PORT} restricted to ${PANEL_IP})."
            else
                ufw allow "${XUI_PORT}/tcp" comment '3x-ui-Panel' >/dev/null 2>&1 || true
                ufw --force enable >/dev/null 2>&1 || true
                ok "UFW firewall enabled (SSH:${SSH_PORT}, 80, 443, and 3x-ui port ${XUI_PORT} open to all IPs)."
            fi
        fi
    else
        if [ -n "$PANEL_IP" ]; then
            ufw allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp comment 'Remnawave-Panel' >/dev/null 2>&1 || true
        fi
        ufw --force enable >/dev/null 2>&1 || true
        ok "UFW firewall enabled (SSH:${SSH_PORT}, 80, 443, and ${NODE_PORT} from ${PANEL_IP})."
    fi

    # Deploy containers via nodeKeeper mode switch
    UNATTENDED="$UNATTENDED" NK_FROM_INSTALLER="true" XUI_INIT_PASSWORD="${XUI_PASSWORD}" /usr/local/bin/nodeKeeper mode "$INSTALL_MODE"

    # Reload NK_ENV in case SSL setup fell back to HTTP mode or generated PG password, and read API token
    if [ -f "$NK_ENV" ]; then
        # shellcheck disable=SC1090
        source "$NK_ENV"
    fi
    if [ -f "$NK_XUI_TOKEN_FILE" ]; then
        XUI_API_TOKEN=$(cat "$NK_XUI_TOKEN_FILE" 2>/dev/null || true)
        rm -f "$NK_XUI_TOKEN_FILE"
    fi

    step "8/8 Configuring Maintenance & Auto-Update Schedules"
    if [ "$MAINT_ENABLED" = "true" ]; then
        /usr/local/bin/nodeKeeper schedule enable
    else
        /usr/local/bin/nodeKeeper schedule disable
    fi

    if [ "$AUTO_UPDATE_ENABLED" = "true" ]; then
        /usr/local/bin/nodeKeeper update enable
    else
        /usr/local/bin/nodeKeeper update disable
    fi
}

