init_3xui_settings() {
    local init_pass="${1:-}"
    if [ ! -f "${XUI_DIR}/docker-compose.yml" ]; then
        err "3x-ui compose file not found at ${XUI_DIR}/docker-compose.yml"
        return 1
    fi

    info "Pulling 3x-ui Docker image..."
    (cd "$XUI_DIR" && docker compose pull)

    local -a setting_args=()
    [ -n "$XUI_USERNAME" ] && setting_args+=(-username "$XUI_USERNAME")
    [ -n "$init_pass" ] && setting_args+=(-password "$init_pass")
    [ -n "$XUI_PORT" ] && setting_args+=(-port "$XUI_PORT")
    if [ -n "$XUI_WEB_BASE_PATH" ] && [ "$XUI_WEB_BASE_PATH" != "/" ]; then
        setting_args+=(-webBasePath "$XUI_WEB_BASE_PATH")
    fi

    if [ ${#setting_args[@]} -gt 0 ]; then
        info "Configuring 3x-ui panel credentials and port (${XUI_PORT})..."
        if (cd "$XUI_DIR" && docker compose run --rm --entrypoint /app/x-ui 3xui setting "${setting_args[@]}"); then
            ok "3x-ui panel settings applied."
        else
            warn "3x-ui CLI setting command returned non-zero; verify credentials via 'docker exec 3xui_app /app/x-ui setting -show true'."
        fi
    fi
}

