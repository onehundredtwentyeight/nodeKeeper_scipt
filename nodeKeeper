#!/usr/bin/env bash
# ==============================================================================
# nodeKeeper — Remnawave & 3x-ui Node Control CLI
# Versioning: MAJOR.MINOR (major/medium) | MAJOR.MINOR.PATCH (small)
# ==============================================================================
set -o pipefail

NK_VERSION="1.2"
NK_REPO_RAW_URL_DEFAULT="https://raw.githubusercontent.com/onehundredtwentyeight/nodeKeeper_scipt/main"
NK_DIR="/opt/nodekeeper"
NK_ENV="${NK_DIR}/nodekeeper.env"
NK_LOG_DIR="${NK_DIR}/logs"
NK_MAINT_SCRIPT="${NK_DIR}/maintenance.sh"
NK_AUTOUPDATE_LOG="${NK_LOG_DIR}/autoupdate.log"
NK_XUI_TOKEN_FILE="${NK_DIR}/.xui_api_token"
REMNA_DIR="/opt/remnanode"
XUI_DIR="/opt/3x-ui"
HTML_DIR="/var/www/html"

# Colors
# shellcheck disable=SC2034
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_CYAN="\033[1;36m"
# shellcheck disable=SC2034
C_BLUE="\033[1;34m"
# shellcheck disable=SC2034
C_MAGENTA="\033[1;35m"
# shellcheck disable=SC2034
C_GRAY="\033[0;90m"

info()  { echo -e "${C_CYAN}[INFO]${C_RESET} $*"; }
ok()    { echo -e "${C_GREEN}[OK]${C_RESET} $*"; }
warn()  { echo -e "${C_YELLOW}[WARN]${C_RESET} $*"; }
err()   { echo -e "${C_RED}[ERROR]${C_RESET} $*" >&2; }

ensure_root() {
    if [ "${EUID:-$(id -u)}" -ne 0 ]; then
        if command -v sudo >/dev/null 2>&1; then
            exec sudo -E "$0" "$@"
        else
            err "This utility must be run as root or via sudo."
            exit 1
        fi
    fi
}

tty_read() {
    local prompt="$1"
    local var_name="$2"
    local default_val="${3:-}"
    local input=""

    if [ -r /dev/tty ]; then
        read -rp "$prompt" input < /dev/tty
    else
        read -rp "$prompt" input
    fi

    if [ -z "$input" ] && [ -n "$default_val" ]; then
        printf -v "$var_name" '%s' "$default_val"
    else
        printf -v "$var_name" '%s' "$input"
    fi
}

version_gt() {
    # Returns 0 (true) if $1 > $2 (supports X.Y and X.Y.Z)
    local -a v1=() v2=()
    IFS=. read -r -a v1 <<< "$1"
    IFS=. read -r -a v2 <<< "$2"
    local i n1 n2
    for i in 0 1 2; do
        n1="${v1[$i]:-0}"
        n2="${v2[$i]:-0}"
        n1="${n1//[^0-9]/}"; n1="${n1:-0}"
        n2="${n2//[^0-9]/}"; n2="${n2:-0}"
        if (( 10#$n1 > 10#$n2 )); then return 0; fi
        if (( 10#$n1 < 10#$n2 )); then return 1; fi
    done
    return 1
}

validate_ipv4() {
    local ip="$1"
    if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        local IFS='.'
        local -a octets
        read -r -a octets <<< "$ip"
        local o
        for o in "${octets[@]}"; do
            if [ "$o" -gt 255 ] 2>/dev/null; then
                return 1
            fi
        done
        return 0
    fi
    return 1
}

validate_port() {
    local port="$1"
    [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ]
}

generate_password() {
    openssl rand -base64 32 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 20
}

generate_xui_username() {
    local first rest
    first=$(openssl rand -base64 16 2>/dev/null | LC_ALL=C tr -dc 'a-z' | head -c 1)
    rest=$(openssl rand -base64 24 2>/dev/null | LC_ALL=C tr -dc 'a-z0-9' | head -c 9)
    echo "${first:-u}${rest:-xuiadmin01}"
}

generate_xui_base_path() {
    local seg
    seg=$(openssl rand -base64 24 2>/dev/null | LC_ALL=C tr -dc 'a-z0-9' | head -c 15)
    echo "/${seg:-xui7k9m2p4x8q1w}/"
}

normalize_web_base_path() {
    local p="${1:-}"
    p="${p#"${p%%[![:space:]]*}"}"
    p="${p%"${p##*[![:space:]]}"}"
    if [ -z "$p" ] || [ "$p" = "/" ]; then
        echo "/"
        return 0
    fi
    [[ "$p" != /* ]] && p="/${p}"
    [[ "$p" != */ ]] && p="${p}/"
    echo "$p"
}

generate_xui_port() {
    local port candidate attempt=0
    while [ "$attempt" -lt 30 ]; do
        candidate=$(( (RANDOM % 50000) + 10000 ))
        if [ "$candidate" != "${SSH_PORT:-22}" ] && [ "$candidate" != "${NODE_PORT:-2222}" ] && [ "$candidate" != "5432" ]; then
            if command -v ss >/dev/null 2>&1; then
                if ! ss -tuln 2>/dev/null | grep -qE "[:.]${candidate}[[:space:]]"; then
                    port="$candidate"
                    break
                fi
            else
                port="$candidate"
                break
            fi
        fi
        attempt=$((attempt + 1))
    done
    echo "${port:-20530}"
}

get_public_ipv4() {
    curl -4 -fsSL --connect-timeout 5 https://api.ipify.org 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1"
}

xui_panel_scheme() {
    if [ "${XUI_SSL_MODE:-none}" = "domain" ] || [ "${XUI_SSL_MODE:-none}" = "ip" ]; then
        echo "https"
    else
        echo "http"
    fi
}

xui_panel_host() {
    if [ "${XUI_SSL_MODE:-none}" = "domain" ] && [ -n "${XUI_SSL_DOMAIN:-}" ]; then
        echo "$XUI_SSL_DOMAIN"
    else
        get_public_ipv4
    fi
}

xui_panel_url() {
    local scheme host path
    scheme=$(xui_panel_scheme)
    host=$(xui_panel_host)
    path=$(normalize_web_base_path "${XUI_WEB_BASE_PATH:-/}")
    echo "${scheme}://${host}:${XUI_PORT}${path}"
}

active_compose_dir() {
    if [ "${INSTALL_MODE:-basic}" = "3xui" ]; then
        echo "$XUI_DIR"
    else
        echo "$REMNA_DIR"
    fi
}

resolve_admin_user() {
    if [ -n "${ADMIN_USER:-}" ] && [ "$ADMIN_USER" != "root" ] && id "$ADMIN_USER" >/dev/null 2>&1; then
        echo "$ADMIN_USER"
        return 0
    fi
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ] && id "$SUDO_USER" >/dev/null 2>&1; then
        echo "$SUDO_USER"
        return 0
    fi
    if id node >/dev/null 2>&1; then
        echo "node"
        return 0
    fi
    return 1
}

fix_service_dir_permissions() {
    local target_user
    target_user=$(resolve_admin_user || true)

    # Ensure webroot isn't stuck at 0700 from older umask behavior
    if [ -d "$HTML_DIR" ]; then
        chmod 755 "$HTML_DIR" 2>/dev/null || true
        [ -f "${HTML_DIR}/index.html" ] && chmod 644 "${HTML_DIR}/index.html" 2>/dev/null || true
    fi

    if [ -z "$target_user" ]; then
        warn "Could not resolve a non-root admin user; skipping service directory ownership changes."
        return 0
    fi

    if [ -d "$REMNA_DIR" ]; then
        chown -R "${target_user}:${target_user}" "$REMNA_DIR"
        find "$REMNA_DIR" -type d -exec chmod 750 {} + 2>/dev/null || chmod 750 "$REMNA_DIR"
        [ -f "${REMNA_DIR}/docker-compose.yml" ] && chmod 600 "${REMNA_DIR}/docker-compose.yml"
        [ -f "${REMNA_DIR}/Caddyfile" ] && chmod 644 "${REMNA_DIR}/Caddyfile"
        [ -f "${REMNA_DIR}/caddy-build/Dockerfile" ] && chmod 644 "${REMNA_DIR}/caddy-build/Dockerfile"
        ok "Permissions on ${REMNA_DIR} updated for user '${target_user}'."
    fi

    if [ -d /var/log/remnanode ]; then
        chown -R "${target_user}:${target_user}" /var/log/remnanode
        chmod 750 /var/log/remnanode
    fi

    if [ -d "$XUI_DIR" ]; then
        chown "${target_user}:${target_user}" "$XUI_DIR"
        chmod 750 "$XUI_DIR"
        local sub
        for sub in db cert acme; do
            if [ -d "${XUI_DIR}/${sub}" ]; then
                chown -R "${target_user}:${target_user}" "${XUI_DIR}/${sub}"
            fi
        done
        if [ -f "${XUI_DIR}/docker-compose.yml" ]; then
            chown "${target_user}:${target_user}" "${XUI_DIR}/docker-compose.yml"
            chmod 600 "${XUI_DIR}/docker-compose.yml"
        fi
        ok "Permissions on ${XUI_DIR} updated for user '${target_user}'."
    fi
}

configure_passwordless_sudo() {
    local target_user
    target_user=$(resolve_admin_user || true)
    if [ -z "$target_user" ]; then
        warn "Could not resolve a non-root admin user; skipping passwordless sudo configuration."
        return 0
    fi

    local safe_user="${target_user//[^a-zA-Z0-9_-]/_}"
    local sudoers_file="/etc/sudoers.d/90-nodekeeper-${safe_user}"
    local tmp_sudoers
    tmp_sudoers=$(mktemp /tmp/nodekeeper-sudoers.XXXXXX)

    mkdir -p /etc/sudoers.d
    cat > "$tmp_sudoers" <<EOF
${target_user} ALL=(ALL:ALL) NOPASSWD: ALL
EOF
    chmod 440 "$tmp_sudoers"

    if command -v visudo >/dev/null 2>&1; then
        if ! visudo -cf "$tmp_sudoers" >/dev/null 2>&1; then
            rm -f "$tmp_sudoers"
            err "Generated sudoers rule failed visudo syntax validation; aborting sudoers update."
            return 1
        fi
    fi

    chown root:root "$tmp_sudoers" 2>/dev/null || true
    mv "$tmp_sudoers" "$sudoers_file"
    chmod 440 "$sudoers_file"
    ok "Passwordless sudo (NOPASSWD) configured for user '${target_user}' (${sudoers_file})."
}

load_env() {
    mkdir -p "$NK_DIR" "$NK_LOG_DIR"
    if [ -f "$NK_ENV" ]; then
        # shellcheck disable=SC1090
        source "$NK_ENV"
    fi
    NK_INSTALLED_VERSION="${NK_INSTALLED_VERSION:-$NK_VERSION}"
    NK_REPO_RAW_URL="${NK_REPO_RAW_URL:-$NK_REPO_RAW_URL_DEFAULT}"
    AUTO_UPDATE_ENABLED="${AUTO_UPDATE_ENABLED:-true}"
    NODE_HOSTNAME="${NODE_HOSTNAME:-$(hostname)}"
    INSTALL_MODE="${INSTALL_MODE:-basic}"
    SELF_STEAL_DOMAIN="${SELF_STEAL_DOMAIN:-}"
    CLOUDFLARE_API_TOKEN="${CLOUDFLARE_API_TOKEN:-}"
    PANEL_IP="${PANEL_IP:-}"
    NODE_PORT="${NODE_PORT:-2222}"
    SECRET_KEY="${SECRET_KEY:-}"
    XUI_USERNAME="${XUI_USERNAME:-}"
    XUI_PORT="${XUI_PORT:-}"
    XUI_WEB_BASE_PATH="${XUI_WEB_BASE_PATH:-/}"
    XUI_SSL_MODE="${XUI_SSL_MODE:-none}"
    XUI_SSL_DOMAIN="${XUI_SSL_DOMAIN:-}"
    XUI_DB_TYPE="${XUI_DB_TYPE:-sqlite}"
    XUI_PG_PASSWORD="${XUI_PG_PASSWORD:-}"
    ADMIN_USER="${ADMIN_USER:-node}"
    SSH_PORT="${SSH_PORT:-22}"
    SERVER_DISABLED="${SERVER_DISABLED:-false}"
    MAINT_ENABLED="${MAINT_ENABLED:-true}"
    MAINT_MIN_DAYS="${MAINT_MIN_DAYS:-5}"
    MAINT_MAX_DAYS="${MAINT_MAX_DAYS:-10}"
    MAINT_LOGGING="${MAINT_LOGGING:-true}"
    MAINT_EXTRA_CMD="${MAINT_EXTRA_CMD:-}"
}

save_env() {
    mkdir -p "$NK_DIR"
    (
        umask 077
        cat > "$NK_ENV" <<EOF
