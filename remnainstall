load_config_source() {
    [ -z "$CONFIG_SOURCE" ] && return 0
    if [[ "$CONFIG_SOURCE" =~ ^https?:// ]]; then
        info "Fetching remote configuration from ${CONFIG_SOURCE}..."
        local tmp_cfg
        tmp_cfg=$(mktemp)
        if curl -fsSL "$CONFIG_SOURCE" -o "$tmp_cfg"; then
            # shellcheck disable=SC1090
            source "$tmp_cfg"
            rm -f "$tmp_cfg"
            ok "Remote configuration loaded."
        else
            rm -f "$tmp_cfg"
            err "Failed to download config from ${CONFIG_SOURCE}"
            exit 1
        fi
    elif [ -f "$CONFIG_SOURCE" ]; then
        info "Loading configuration from ${CONFIG_SOURCE}..."
        # shellcheck disable=SC1090
        source "$CONFIG_SOURCE"
        ok "Configuration file loaded."
    else
        err "Configuration file not found: ${CONFIG_SOURCE}"
        exit 1
    fi
}

# Safe interactive read that works even when script is piped via `curl ... | bash`
tty_read() {
    local prompt="$1"
    local var_name="$2"
    local default_val="${3:-}"
    local input=""

    if [ -r /dev/tty ]; then
        read -rp "$prompt" input < /dev/tty
    else
        read -rp "$prompt" input
    fi

    if [ -z "$input" ] && [ -n "$default_val" ]; then
        printf -v "$var_name" '%s' "$default_val"
    else
        printf -v "$var_name" '%s' "$input"
    fi
}

version_gt() {
    # Returns 0 (true) if $1 > $2 (supports X.Y and X.Y.Z)
    local -a v1=() v2=()
    IFS=. read -r -a v1 <<< "$1"
    IFS=. read -r -a v2 <<< "$2"
    local i n1 n2
    for i in 0 1 2; do
        n1="${v1[$i]:-0}"
        n2="${v2[$i]:-0}"
        n1="${n1//[^0-9]/}"; n1="${n1:-0}"
        n2="${n2//[^0-9]/}"; n2="${n2:-0}"
        if (( 10#$n1 > 10#$n2 )); then return 0; fi
        if (( 10#$n1 < 10#$n2 )); then return 1; fi
    done
    return 1
}

generate_password() {
    openssl rand -base64 32 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 20
}

generate_xui_username() {
    local first rest
    first=$(openssl rand -base64 16 2>/dev/null | LC_ALL=C tr -dc 'a-z' | head -c 1)
    rest=$(openssl rand -base64 24 2>/dev/null | LC_ALL=C tr -dc 'a-z0-9' | head -c 9)
    echo "${first:-u}${rest:-xuiadmin01}"
}

generate_xui_base_path() {
    local seg
    seg=$(openssl rand -base64 24 2>/dev/null | LC_ALL=C tr -dc 'a-z0-9' | head -c 15)
    echo "/${seg:-xui7k9m2p4x8q1w}/"
}

normalize_web_base_path() {
    local p="${1:-}"
    p="${p#"${p%%[![:space:]]*}"}"
    p="${p%"${p##*[![:space:]]}"}"
    if [ -z "$p" ] || [ "$p" = "/" ]; then
        echo "/"
        return 0
    fi
    [[ "$p" != /* ]] && p="/${p}"
    [[ "$p" != */ ]] && p="${p}/"
    echo "$p"
}

generate_xui_port() {
    local port candidate attempt=0
    while [ "$attempt" -lt 30 ]; do
        candidate=$(( (RANDOM % 50000) + 10000 ))
        if [ "$candidate" != "${SSH_PORT:-22}" ] && [ "$candidate" != "${NODE_PORT:-2222}" ] && [ "$candidate" != "5432" ]; then
            if command -v ss >/dev/null 2>&1; then
                if ! ss -tuln 2>/dev/null | grep -qE "[:.]${candidate}[[:space:]]"; then
                    port="$candidate"
                    break
                fi
            else
                port="$candidate"
                break
            fi
        fi
        attempt=$((attempt + 1))
    done
    echo "${port:-20530}"
}

detect_ssh_port() {
    local port=""
    if [ -f /etc/ssh/sshd_config ]; then
        port=$(awk '/^[[:space:]]*Port[[:space:]]+[0-9]+/ {print $2; exit}' /etc/ssh/sshd_config 2>/dev/null || true)
    fi
    echo "${port:-22}"
}

detect_root_ssh_key() {
    if [ -f /root/.ssh/authorized_keys ]; then
        grep -E '^(ssh-(rsa|ed25519)|ecdsa-sha2-)' /root/.ssh/authorized_keys 2>/dev/null | head -n 1 || true
    fi
}

validate_ipv4() {
    local ip="$1"
    if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        local IFS='.'
        local -a octets
        read -r -a octets <<< "$ip"
        local o
        for o in "${octets[@]}"; do
            if [ "$o" -gt 255 ] 2>/dev/null; then
                return 1
            fi
        done
        return 0
    fi
    return 1
}

validate_port() {
    local port="$1"
    [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ]
}

detect_installed_version() {
    local ver=""
    if [ -f "$NK_ENV" ]; then
        ver=$(grep -m1 '^NK_INSTALLED_VERSION=' "$NK_ENV" 2>/dev/null \
            | sed -E "s/^NK_INSTALLED_VERSION=['\"]?([^'\"#[:space:]]+)['\"]?.*/\1/" || true)
    fi
    if [ -z "$ver" ] && [ -f /usr/local/bin/nodeKeeper ]; then
        ver=$(grep -m1 '^NK_VERSION=' /usr/local/bin/nodeKeeper 2>/dev/null \
            | sed -E "s/^NK_VERSION=['\"]?([^'\"#[:space:]]+)['\"]?.*/\1/" || true)
    fi
    echo "${ver:-1.0}"
}

