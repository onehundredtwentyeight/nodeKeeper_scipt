{
    admin off
    servers unix/{$CADDY_SOCKET_PATH} {
        listener_wrappers {
            proxy_protocol
            tls
        }
    }
    auto_https disable_redirects
}

http://{$SELF_STEAL_DOMAIN} {
    bind 0.0.0.0
    redir https://{$SELF_STEAL_DOMAIN}{uri} permanent
}

# Основной блок HTTPS для браузеров (TCP)
https://{$SELF_STEAL_DOMAIN} {
    bind unix/{$CADDY_SOCKET_PATH}
    root * /var/www/html
    try_files {path} /index.html
    file_server

    # --- НАСТРОЙКА DNS-01 CHALLENGE ---
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        # Указываем резолверы Cloudflare для надежности проверки
        resolvers 1.1.1.1 1.0.0.1
    }
    # ----------------------------------
}

# Блок для маскировки Hysteria (Локальный HTTP)
http://127.0.0.1:8080 {
    bind 127.0.0.1
    root * /var/www/html
    try_files {path} /index.html
    file_server
}

:80 {
    bind 0.0.0.0
    respond 204
}
