EOF
}

# ==============================================================================
# Entrypoint
# ==============================================================================
if [[ "${1:-}" =~ ^(-h|--help|help)$ ]]; then
    show_help
    exit 0
fi

if [[ "${1:-}" =~ ^(-v|--version|version)$ ]]; then
    echo "nodeKeeper v${NK_VERSION}"
    exit 0
fi

ensure_root "$@"
load_env

SUBCMD="${1:-menu}"
shift || true

case "$SUBCMD" in
    menu)            interactive_menu ;;
    status)          cmd_status ;;
    start)           cmd_start ;;
    stop)            cmd_stop ;;
    restart)         cmd_restart ;;
    disable)         cmd_disable_server ;;
    enable)          cmd_enable_server ;;
    mode)            cmd_switch_mode "${1:-}" ;;
    xui-token)       cmd_xui_token ;;
    xui)
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx '3xui_app'; then
            docker exec -it 3xui_app x-ui
        else
            err "3xui_app container is not running."
            exit 1
        fi
        ;;
    fix-permissions) fix_service_dir_permissions ;;
    fix-sudo)        configure_passwordless_sudo ;;
    update)          cmd_update "${1:-now}" "${2:-}" ;;
    schedule)
        S_ACT="${1:-status}"
        case "$S_ACT" in
            enable)  schedule_enable ;;
            disable) schedule_disable ;;
            status)  schedule_status ;;
            refresh)
                generate_maintenance_script
                ok "Maintenance script regenerated."
                ;;
            freq)
                MAINT_MIN_DAYS="${2:-5}"
                MAINT_MAX_DAYS="${3:-10}"
                save_env
                [ "$MAINT_ENABLED" = "true" ] && schedule_enable
                ;;
            logs)
                MAINT_LOGGING="${2:-true}"
                save_env
                generate_maintenance_script
                ok "Maintenance logging set to ${MAINT_LOGGING}"
                ;;
            extra-cmd)
                MAINT_EXTRA_CMD="${2:-}"
                save_env
                generate_maintenance_script
                ok "Extra command set to: ${MAINT_EXTRA_CMD}"
                ;;
            *) err "Unknown schedule action: $S_ACT"; show_help; exit 1 ;;
        esac
        ;;
    logs)
        L_TYPE="${1:-}"
        if [ -z "$L_TYPE" ]; then
            [ "$INSTALL_MODE" = "3xui" ] && L_TYPE="3xui" || L_TYPE="remnanode"
        fi
        case "$L_TYPE" in
            remnanode)  docker logs --tail 100 remnanode ;;
            caddy)      docker logs --tail 100 caddy-remnawave ;;
            3xui|xui)   docker logs --tail 100 3xui_app ;;
            postgres)   docker logs --tail 100 3xui_postgres ;;
            maint)      cat "$(ls -t "${NK_LOG_DIR}"/update_*.log 2>/dev/null | head -n1)" ;;
            tests)      cat "$(ls -t "${NK_LOG_DIR}"/tests_*.log 2>/dev/null | head -n1)" ;;
            autoupdate) [ -f "$NK_AUTOUPDATE_LOG" ] && tail -n 100 "$NK_AUTOUPDATE_LOG" || info "No auto-update log found." ;;
            *)          menu_logs ;;
        esac
        ;;
    uninstall)       cmd_uninstall "${1:-}" ;;
    -h|--help|help)  show_help ;;
    *)               err "Unknown command: $SUBCMD"; show_help; exit 1 ;;
esac
NK_EOF
    fi

    if ! bash -n "$tmp_nk" 2>/dev/null; then
        rm -f "$tmp_nk"
        err "Generated nodeKeeper binary failed bash syntax check! Aborting installation."
        exit 1
    fi

    chmod 755 "$tmp_nk"
    mv "$tmp_nk" /usr/local/bin/nodeKeeper
    ln -sf /usr/local/bin/nodeKeeper /usr/local/bin/nodekeeper

    # Add shell alias for root and ADMIN_USER
    local rc_file
    for rc_file in /root/.bashrc "/home/${ADMIN_USER}/.bashrc"; do
        if [ -f "$rc_file" ] && ! grep -q "alias nodeKeeper=" "$rc_file" 2>/dev/null; then
            echo "alias nodeKeeper='sudo /usr/local/bin/nodeKeeper'" >> "$rc_file"
        fi
    done

    ok "nodeKeeper v${INSTALLER_VERSION} installed to /usr/local/bin/nodeKeeper"
}

perform_upgrade() {
    local old_ver="${1:-1.0}"
    step "Upgrading nodeKeeper (v${old_ver} -> v${INSTALLER_VERSION})"

    # Preserve existing node configuration from nodekeeper.env
    if [ -f "$NK_ENV" ]; then
        # shellcheck disable=SC1090
        source "$NK_ENV"
    fi

    # Fill defaults for fields introduced in v1.1+ / v1.2+
    NK_REPO_RAW_URL="${NK_REPO_RAW_URL:-https://raw.githubusercontent.com/onehundredtwentyeight/nodeKeeper_scipt/main}"
    if [ "$CLI_NO_AUTO_UPDATE" = "true" ]; then
        AUTO_UPDATE_ENABLED="false"
    else
        AUTO_UPDATE_ENABLED="${AUTO_UPDATE_ENABLED:-true}"
    fi
    NODE_HOSTNAME="${NODE_HOSTNAME:-$(hostname)}"
    INSTALL_MODE="${INSTALL_MODE:-basic}"
    ADMIN_USER="${ADMIN_USER:-node}"
    SSH_PORT="${SSH_PORT:-$(detect_ssh_port)}"
    SERVER_DISABLED="${SERVER_DISABLED:-false}"
    XUI_WEB_BASE_PATH="${XUI_WEB_BASE_PATH:-/}"
    XUI_SSL_MODE="${XUI_SSL_MODE:-none}"
    XUI_SSL_DOMAIN="${XUI_SSL_DOMAIN:-}"
    XUI_DB_TYPE="${XUI_DB_TYPE:-sqlite}"
    XUI_PG_PASSWORD="${XUI_PG_PASSWORD:-}"
    MAINT_ENABLED="${MAINT_ENABLED:-true}"
    MAINT_MIN_DAYS="${MAINT_MIN_DAYS:-5}"
    MAINT_MAX_DAYS="${MAINT_MAX_DAYS:-10}"
    MAINT_LOGGING="${MAINT_LOGGING:-true}"

    # 1. Update nodeKeeper CLI binary
    write_nodekeeper_binary

    # 2. Save updated nodekeeper.env with new version & schema defaults
    write_nk_env_file
    ok "Configuration preserved and updated (${NK_ENV})."

    # 3. Migration: fix /opt/remnanode (and /opt/3x-ui, /var/log/remnanode, /var/www/html) permissions
    info "Running migration: updating service directory permissions for '${ADMIN_USER}'..."
    /usr/local/bin/nodeKeeper fix-permissions

    # 4. Migration: enable passwordless sudo (NOPASSWD) for non-interactive tasks (v1.1.1+)
    info "Running migration: configuring passwordless sudo for '${ADMIN_USER}'..."
    /usr/local/bin/nodeKeeper fix-sudo

    # 5. Migration: refresh maintenance script without resetting existing schedule
    if [ "$MAINT_ENABLED" = "true" ]; then
        info "Refreshing maintenance script (${NK_DIR}/maintenance.sh)..."
        /usr/local/bin/nodeKeeper schedule refresh
    fi

    # 6. Migration: enable auto-update cron (keeping existing cron schedule if already set)
    if [ "$AUTO_UPDATE_ENABLED" = "true" ]; then
        /usr/local/bin/nodeKeeper update enable true
    else
        /usr/local/bin/nodeKeeper update disable
    fi

    echo -e "\n${C_GREEN}${C_BOLD}====================================================================${C_RESET}"
    echo -e "${C_GREEN}${C_BOLD}              nodeKeeper UPGRADE COMPLETED SUCCESSFULLY!            ${C_RESET}"
    echo -e "${C_GREEN}${C_BOLD}====================================================================${C_RESET}"
    echo -e "  Previous Version:    ${C_CYAN}v${old_ver}${C_RESET}"
    echo -e "  Current Version:     ${C_GREEN}v${INSTALLER_VERSION}${C_RESET}"
    echo -e "  Install Mode:        ${C_CYAN}${INSTALL_MODE}${C_RESET}"
    echo -e "  Admin User:          ${C_CYAN}${ADMIN_USER}${C_RESET} (service dir permissions & passwordless sudo applied)"
    echo -e "  Auto-Update Cron:    ${C_CYAN}${AUTO_UPDATE_ENABLED}${C_RESET}"
    echo -e "${C_GREEN}${C_BOLD}====================================================================${C_RESET}\n"
}

check_existing_installation() {
    if [ ! -f /usr/local/bin/nodeKeeper ] && [ ! -f "$NK_ENV" ]; then
        if [ "$UPDATE_ONLY" = "true" ]; then
            err "No existing nodeKeeper installation found to update."
            exit 1
        fi
        return 0
    fi

    if [ "$FORCE_REINSTALL" = "true" ]; then
        warn "Existing nodeKeeper installation detected; proceeding with full reinstall (--reinstall)."
        return 0
    fi

    local installed_ver
    installed_ver=$(detect_installed_version)

    if [ "$UPDATE_ONLY" = "true" ]; then
        perform_upgrade "$installed_ver"
        exit 0
    fi

    if [ "$UNATTENDED" = "true" ]; then
        if [ -z "$CONFIG_SOURCE" ] && [ -z "$INSTALL_MODE" ] && [ -z "$SECRET_KEY" ]; then
            info "Existing nodeKeeper v${installed_ver} detected in unattended mode; running upgrade..."
            perform_upgrade "$installed_ver"
            exit 0
        fi
        warn "Existing nodeKeeper v${installed_ver} detected; proceeding with unattended setup."
        return 0
    fi

    echo -e "\n${C_BOLD}╭────────────────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${C_BOLD}│       Existing nodeKeeper Installation Detected                    │${C_RESET}"
    echo -e "${C_BOLD}╰────────────────────────────────────────────────────────────────────╯${C_RESET}"
    echo -e "  Installed version:   ${C_CYAN}v${installed_ver}${C_RESET}"
    echo -e "  Installer version:   ${C_GREEN}v${INSTALLER_VERSION}${C_RESET}"
    if version_gt "$INSTALLER_VERSION" "$installed_ver"; then
        echo -e "  Status:              ${C_GREEN}Update available (v${installed_ver} -> v${INSTALLER_VERSION})${C_RESET}"
    else
        echo -e "  Status:              ${C_YELLOW}Already up to date (you can still re-apply update/migrations)${C_RESET}"
    fi
    echo ""
    echo "  1) Update nodeKeeper to v${INSTALLER_VERSION} & apply migrations (recommended)"
    echo "  2) Reinstall from scratch (run full installation wizard)"
    echo "  3) Cancel and exit"
    echo ""

    local upg_choice=""
    while true; do
        tty_read "Select option [1-3, default 1]: " upg_choice "1"
        case "$upg_choice" in
            1)
                perform_upgrade "$installed_ver"
                exit 0
                ;;
            2)
                warn "Proceeding with full fresh installation..."
                return 0
                ;;
            3)
                info "Operation cancelled."
                exit 0
                ;;
            *)
                warn "Please choose 1, 2, or 3."
                ;;
        esac
    done
}

# ==============================================================================
# Step 1: Collect All Parameters Up Front
# ==============================================================================
collect_parameters() {
    echo -e "\n${C_BOLD}╭────────────────────────────────────────────────────────────────────╮${C_RESET}"
    echo -e "${C_BOLD}│       Remnawave & 3x-ui Installer / nodeKeeper v${INSTALLER_VERSION}                │${C_RESET}"
    echo -e "${C_BOLD}╰────────────────────────────────────────────────────────────────────╯${C_RESET}"

    [ -z "$SSH_PORT" ] && SSH_PORT=$(detect_ssh_port)
    [ -z "$ADMIN_PASSWORD" ] && ADMIN_PASSWORD=$(generate_password)

    local detected_key
    detected_key=$(detect_root_ssh_key)

    if [ "$UNATTENDED" = "true" ]; then
        info "Running in unattended mode."
        [ -z "$NODE_HOSTNAME" ] && NODE_HOSTNAME=$(hostname)
        [ -z "$INSTALL_MODE" ] && INSTALL_MODE="basic"
        [ -z "$SSH_PUBLIC_KEY" ] && SSH_PUBLIC_KEY="$detected_key"
    else
        echo -e "${C_GRAY}Please enter all deployment parameters once. The installation will then run completely unattended.${C_RESET}\n"

        # 1. Hostname
        while [ -z "$NODE_HOSTNAME" ]; do
            tty_read "1. Enter full node hostname (e.g. kvn-msk10 / fin-node-01) [$(hostname)]: " NODE_HOSTNAME "$(hostname)"
        done

        # 2. Install Mode
        if [ -z "$INSTALL_MODE" ]; then
            echo -e "\n${C_BOLD}2. Select Installation Mode:${C_RESET}"
            echo "   1) basic            — Remnanode only (no Caddy reverse proxy)"
            echo "   2) selfsteal-single — Remnanode + Caddy (one server per domain, HTTP-01)"
            echo "   3) selfsteal-multi  — Remnanode + Caddy with Cloudflare DNS plugin (multi-server)"
            echo "   4) 3xui             — 3x-ui Panel in Docker container"
            local mode_choice=""
            while true; do
                tty_read "   Select mode [1-4, default 3]: " mode_choice "3"
                case "$mode_choice" in
                    1|basic)            INSTALL_MODE="basic"; break ;;
                    2|selfsteal-single) INSTALL_MODE="selfsteal-single"; break ;;
                    3|selfsteal-multi)  INSTALL_MODE="selfsteal-multi"; break ;;
                    4|3xui|3x-ui|xui)   INSTALL_MODE="3xui"; break ;;
                    *) warn "Please choose 1, 2, 3, or 4." ;;
                esac
            done
        fi
    fi

    # Normalize mode names
    case "$INSTALL_MODE" in
        1|basic|no-caddy)                    INSTALL_MODE="basic" ;;
        2|single|selfsteal|selfsteal-single) INSTALL_MODE="selfsteal-single" ;;
        3|multi|cloudflare|selfsteal-multi)  INSTALL_MODE="selfsteal-multi" ;;
        4|3xui|3x-ui|xui|x-ui)               INSTALL_MODE="3xui" ;;
        *) err "Invalid INSTALL_MODE: $INSTALL_MODE"; exit 1 ;;
    esac

    # Pre-generate random 3x-ui defaults when in 3xui mode
    local def_xui_user def_xui_pass def_xui_port def_xui_path
    if [ "$INSTALL_MODE" = "3xui" ]; then
        def_xui_user="${XUI_USERNAME:-$(generate_xui_username)}"
        def_xui_pass="${XUI_PASSWORD:-$(generate_password)}"
        def_xui_port="${XUI_PORT:-$(generate_xui_port)}"
        def_xui_path="${XUI_WEB_BASE_PATH:-$(generate_xui_base_path)}"
    fi

    if [ "$UNATTENDED" != "true" ]; then
        if [ "$INSTALL_MODE" = "3xui" ]; then
            echo -e "\n${C_BOLD}--- 3x-ui Panel Parameters (Docker) ---${C_RESET}"

            # 1) Domain / SSL Mode
            if [ -z "$XUI_SSL_MODE" ]; then
                echo -e "${C_BOLD}3. Select 3x-ui Panel SSL Configuration:${C_RESET}"
                echo "   1) domain — Issue Let's Encrypt SSL certificate for a domain"
                echo "   2) ip     — Issue Let's Encrypt short-lived SSL certificate for server IP"
                echo "   3) none   — Skip SSL (HTTP only, for reverse proxy / SSH tunnel)"
                local ssl_choice=""
                while true; do
                    tty_read "   Select SSL option [1-3, default 1]: " ssl_choice "1"
                    case "$ssl_choice" in
                        1|domain) XUI_SSL_MODE="domain"; break ;;
                        2|ip)     XUI_SSL_MODE="ip"; XUI_SSL_DOMAIN=""; break ;;
                        3|none)   XUI_SSL_MODE="none"; XUI_SSL_DOMAIN=""; break ;;
                        *) warn "Please choose 1, 2, or 3." ;;
                    esac
                done
            fi

            if [ "$XUI_SSL_MODE" = "domain" ]; then
                while [ -z "$XUI_SSL_DOMAIN" ]; do
                    tty_read "   Enter domain for 3x-ui Panel (e.g. panel.example.com): " XUI_SSL_DOMAIN
                done
            fi

            # 2) Login and Password (skip for random)
            tty_read "4. 3x-ui Panel username [Enter for random: ${def_xui_user}]: " XUI_USERNAME "$def_xui_user"
            tty_read "5. 3x-ui Panel password [Enter for random: ${def_xui_pass}]: " XUI_PASSWORD "$def_xui_pass"

            # 3) Port (skip for random)
            local custom_xui_port=""
            while true; do
                tty_read "6. 3x-ui Panel port [Enter for random: ${def_xui_port}]: " custom_xui_port "$def_xui_port"
                if validate_port "$custom_xui_port"; then
                    XUI_PORT="$custom_xui_port"
                    break
                fi
                warn "Invalid port number (must be 1-65535)."
            done

            # 4) Path (domain.com/X) (skip for random)
            local custom_xui_path=""
            tty_read "7. 3x-ui Panel URI path (domain.com/X) [Enter for random: ${def_xui_path}]: " custom_xui_path "$def_xui_path"
            XUI_WEB_BASE_PATH=$(normalize_web_base_path "$custom_xui_path")

            # 5) DB Type (sqlite or postgres in Docker)
            if [ -z "$XUI_DB_TYPE" ]; then
                echo -e "\n${C_BOLD}8. Select 3x-ui Database Backend (Docker):${C_RESET}"
                echo "   1) sqlite   — SQLite file in /opt/3x-ui/db/x-ui.db (mounted to /etc/x-ui/)"
                echo "   2) postgres — PostgreSQL 16 container (3xui_postgres, /opt/3x-ui/pgdata)"
                local db_choice=""
                while true; do
                    tty_read "   Select database backend [1-2, default 1]: " db_choice "1"
                    case "$db_choice" in
                        1|sqlite)      XUI_DB_TYPE="sqlite"; break ;;
                        2|postgres|pg) XUI_DB_TYPE="postgres"; break ;;
                        *) warn "Please choose 1 or 2." ;;
                    esac
                done
            fi

            # 6) Central Panel IPv4 (skip to NOT restrict panel port by IP)
            local custom_panel_ip=""
            while true; do
                tty_read "9. Enter Central Panel IPv4 address (for UFW port whitelist) [Enter to skip and not restrict]: " custom_panel_ip "$PANEL_IP"
                if [ -z "$custom_panel_ip" ]; then
                    PANEL_IP=""
                    break
                elif validate_ipv4 "$custom_panel_ip"; then
                    PANEL_IP="$custom_panel_ip"
                    break
                else
                    warn "Invalid IPv4 address format (leave empty and press Enter to skip restriction)."
                fi
            done
        else
            # Remnanode-specific prompts
            if [ "$INSTALL_MODE" = "selfsteal-single" ] || [ "$INSTALL_MODE" = "selfsteal-multi" ]; then
                while [ -z "$SELF_STEAL_DOMAIN" ]; do
                    tty_read "3. Enter Selfsteal Domain (e.g. node.example.com): " SELF_STEAL_DOMAIN
                done
            fi

            if [ "$INSTALL_MODE" = "selfsteal-multi" ]; then
                while [ -z "$CLOUDFLARE_API_TOKEN" ]; do
                    tty_read "4. Enter Cloudflare API Token (with Zone.DNS:Edit permission): " CLOUDFLARE_API_TOKEN
                done
            fi

            while ! validate_ipv4 "$PANEL_IP"; do
                tty_read "5. Enter Remnawave Panel IPv4 address (for port whitelist): " PANEL_IP
                validate_ipv4 "$PANEL_IP" || warn "Invalid IPv4 address format."
            done

            tty_read "6. Enter Remnanode port [${NODE_PORT}]: " NODE_PORT "$NODE_PORT"

            while [ -z "$SECRET_KEY" ]; do
                tty_read "7. Paste Remnanode SECRET_KEY from Panel: " SECRET_KEY
                SECRET_KEY=$(echo "$SECRET_KEY" | tr -d '[:space:]"')
            done
        fi

        # Hardening User & Password & SSH Key
        echo -e "\n${C_BOLD}--- System Hardening Parameters ---${C_RESET}"
        tty_read "10. New sudo/docker username [${ADMIN_USER}]: " ADMIN_USER "$ADMIN_USER"

        local custom_pass=""
        tty_read "11. Password for '${ADMIN_USER}' [Enter to use auto-generated: ${ADMIN_PASSWORD}]: " custom_pass "$ADMIN_PASSWORD"
        ADMIN_PASSWORD="$custom_pass"

        if [ -z "$SSH_PUBLIC_KEY" ]; then
            if [ -n "$detected_key" ]; then
                echo -e "   Detected existing SSH key in /root/.ssh/authorized_keys:"
                echo -e "   ${C_CYAN}${detected_key:0:65}...${C_RESET}"
                tty_read "12. Paste SSH public key for '${ADMIN_USER}' [Enter to use detected key]: " SSH_PUBLIC_KEY "$detected_key"
            else
                while [ -z "$SSH_PUBLIC_KEY" ]; do
                    tty_read "12. Paste SSH public key for '${ADMIN_USER}' (required to disable password SSH): " SSH_PUBLIC_KEY
                done
            fi
        fi

        # Additional Components
        echo -e "\n${C_BOLD}--- Additional Components ---${C_RESET}"
        local warp_ans=""
        tty_read "13. Install Cloudflare WARP automatically? [Y/n]: " warp_ans "Y"
        [[ "$warp_ans" =~ ^[Nn]$ ]] && INSTALL_WARP="false" || INSTALL_WARP="true"

        local maint_ans=""
        tty_read "14. Enable automated OS & container maintenance cron? [Y/n]: " maint_ans "Y"
        [[ "$maint_ans" =~ ^[Nn]$ ]] && MAINT_ENABLED="false" || MAINT_ENABLED="true"

        local autoupd_ans=""
        tty_read "15. Enable automated nodeKeeper script updates via cron? [Y/n]: " autoupd_ans "Y"
        [[ "$autoupd_ans" =~ ^[Nn]$ ]] && AUTO_UPDATE_ENABLED="false" || AUTO_UPDATE_ENABLED="true"
    fi

    # Finalize and normalize 3x-ui parameters (including unattended defaults)
    if [ "$INSTALL_MODE" = "3xui" ]; then
        [ -z "$XUI_USERNAME" ] && XUI_USERNAME="$def_xui_user"
        [ -z "$XUI_PASSWORD" ] && XUI_PASSWORD="$def_xui_pass"
        [ -z "$XUI_PORT" ] && XUI_PORT="$def_xui_port"
        [ -z "$XUI_WEB_BASE_PATH" ] && XUI_WEB_BASE_PATH="$def_xui_path"
        XUI_WEB_BASE_PATH=$(normalize_web_base_path "$XUI_WEB_BASE_PATH")

        if [ -z "$XUI_SSL_MODE" ]; then
            if [ -n "$XUI_SSL_DOMAIN" ]; then
                XUI_SSL_MODE="domain"
            else
                XUI_SSL_MODE="none"
            fi
        fi
        case "$XUI_SSL_MODE" in
            1|domain)       XUI_SSL_MODE="domain" ;;
            2|ip)           XUI_SSL_MODE="ip"; XUI_SSL_DOMAIN="" ;;
            3|none|skip|"") XUI_SSL_MODE="none"; XUI_SSL_DOMAIN="" ;;
            *) err "Invalid XUI_SSL_MODE: $XUI_SSL_MODE (use: domain | ip | none)"; exit 1 ;;
        esac

        if [ "$XUI_SSL_MODE" = "domain" ] && [ -z "$XUI_SSL_DOMAIN" ]; then
            err "XUI_SSL_DOMAIN (--xui-domain) is required when XUI_SSL_MODE=domain."
            exit 1
        fi

        [ -z "$XUI_DB_TYPE" ] && XUI_DB_TYPE="sqlite"
        case "$XUI_DB_TYPE" in
            1|sqlite)              XUI_DB_TYPE="sqlite" ;;
            2|postgres|postgresql) XUI_DB_TYPE="postgres" ;;
            *) err "Invalid XUI_DB_TYPE: $XUI_DB_TYPE (use: sqlite | postgres)"; exit 1 ;;
        esac
        if [ "$XUI_DB_TYPE" = "postgres" ] && [ -z "$XUI_PG_PASSWORD" ]; then
            XUI_PG_PASSWORD=$(generate_password)
        fi

        if ! validate_port "$XUI_PORT"; then
            err "Valid XUI_PORT (1-65535) is required for mode 3xui."
            exit 1
        fi
        if [ -z "$XUI_USERNAME" ] || [ -z "$XUI_PASSWORD" ]; then
            err "XUI_USERNAME and XUI_PASSWORD are required for mode 3xui."
            exit 1
        fi
        if [ -n "$PANEL_IP" ] && ! validate_ipv4 "$PANEL_IP"; then
            err "Invalid PANEL_IP format: '${PANEL_IP}' (must be valid IPv4 or empty to skip restriction)."
            exit 1
        fi
    else
        if ! validate_ipv4 "$PANEL_IP"; then
            err "Valid PANEL_IP (Remnawave Panel IPv4 address) is required for mode ${INSTALL_MODE}."
            exit 1
        fi
        if [ "$INSTALL_MODE" != "basic" ] && [ -z "$SELF_STEAL_DOMAIN" ]; then
            err "SELF_STEAL_DOMAIN is required for mode ${INSTALL_MODE}."
            exit 1
        fi
        if [ "$INSTALL_MODE" = "selfsteal-multi" ] && [ -z "$CLOUDFLARE_API_TOKEN" ]; then
            err "CLOUDFLARE_API_TOKEN is required for mode selfsteal-multi."
            exit 1
        fi
        if [ -z "$SECRET_KEY" ]; then
            err "SECRET_KEY is required for mode ${INSTALL_MODE}."
            exit 1
        fi
    fi

    # Show Pre-flight Parameter Summary
    echo -e "\n${C_BOLD}====================================================================${C_RESET}"
    echo -e "${C_BOLD}                  DEPLOYMENT CONFIGURATION SUMMARY                  ${C_RESET}"
    echo -e "${C_BOLD}====================================================================${C_RESET}"
    echo -e "  Installer Version:   ${C_CYAN}v${INSTALLER_VERSION}${C_RESET}"
    echo -e "  Hostname:            ${C_CYAN}${NODE_HOSTNAME}${C_RESET}"
    echo -e "  Install Mode:        ${C_CYAN}${INSTALL_MODE}${C_RESET}"
    if [ "$INSTALL_MODE" = "3xui" ]; then
        echo -e "  3x-ui SSL Mode:      ${C_CYAN}${XUI_SSL_MODE}${C_RESET}$([ "$XUI_SSL_MODE" = "domain" ] && echo " (Domain: ${XUI_SSL_DOMAIN})")"
        echo -e "  3x-ui Database:      ${C_CYAN}${XUI_DB_TYPE}${C_RESET} (Docker)"
        echo -e "  3x-ui Username:      ${C_GREEN}${XUI_USERNAME}${C_RESET}"
        echo -e "  3x-ui Password:      ${C_YELLOW}${XUI_PASSWORD}${C_RESET}"
        echo -e "  3x-ui Panel Port:    ${C_CYAN}${XUI_PORT}${C_RESET}"
        echo -e "  3x-ui URI Path:      ${C_CYAN}${XUI_WEB_BASE_PATH}${C_RESET}"
        if [ -n "$PANEL_IP" ]; then
            echo -e "  Central Panel IP:    ${C_CYAN}${PANEL_IP}${C_RESET} (ONLY this IP can access port ${XUI_PORT})"
        else
            echo -e "  Central Panel IP:    ${C_YELLOW}Unrestricted (port ${XUI_PORT} open to all IPs)${C_RESET}"
        fi
    else
        [ -n "$SELF_STEAL_DOMAIN" ] && echo -e "  Selfsteal Domain:    ${C_CYAN}${SELF_STEAL_DOMAIN}${C_RESET}"
        [ "$INSTALL_MODE" = "selfsteal-multi" ] && echo -e "  Cloudflare Token:    ${C_CYAN}${CLOUDFLARE_API_TOKEN:0:8}***${C_RESET}"
        echo -e "  Panel IP Whitelist:  ${C_CYAN}${PANEL_IP}${C_RESET} (Node Port: ${NODE_PORT})"
    fi
    echo -e "  Admin User:          ${C_CYAN}${ADMIN_USER}${C_RESET}"
    echo -e "  Admin Password:      ${C_YELLOW}${ADMIN_PASSWORD}${C_RESET}"
    echo -e "  SSH Key Configured:  ${C_CYAN}$([ -n "$SSH_PUBLIC_KEY" ] && echo "Yes" || echo "No")${C_RESET}"
    echo -e "  SSH Port:            ${C_CYAN}${SSH_PORT}${C_RESET}"
    echo -e "  Cloudflare WARP:     ${C_CYAN}${INSTALL_WARP}${C_RESET}"
    echo -e "  Auto-Maintenance:    ${C_CYAN}${MAINT_ENABLED}${C_RESET} (${MAINT_MIN_DAYS}-${MAINT_MAX_DAYS} days)"
    echo -e "  Auto-Update Cron:    ${C_CYAN}${AUTO_UPDATE_ENABLED}${C_RESET}"
    echo -e "${C_BOLD}====================================================================${C_RESET}"

    if [ "$DRY_RUN" = "true" ]; then
        ok "Dry-run mode enabled. Configuration is valid. No system changes were made."
        exit 0
    fi

    if [ "$UNATTENDED" != "true" ]; then
        # shellcheck disable=SC2034
        local confirm_go=""
        tty_read "Press [Enter] to run IP checks and begin unattended installation (or Ctrl+C to abort): " confirm_go ""
    fi
}

# ==============================================================================
# Step 2: Base Dependencies & Pre-Flight IP Checks
# ==============================================================================
run_preflight_checks() {
    step "1/8 Preparing Base Packages & Running Pre-flight IP Diagnostics"
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y curl wget sudo ca-certificates cron gnupg lsb-release ufw

    mkdir -p "$NK_DIR" "$NK_LOG_DIR"
    local diag_ts diag_log
    diag_ts=$(date +%Y-%m-%d_%H-%M)
    diag_log="${NK_LOG_DIR}/initial_diagnostics_${diag_ts}.log"

    if [ "$RUN_IP_CHECKS" = "true" ]; then
        info "Running IP region and censorship checks (logging to ${diag_log})..."
        echo "=== Initial IP Region & Censorship Check ($(date)) ===" > "$diag_log"
        wget -qO - "https://raw.githubusercontent.com/vernette/ipregion/refs/heads/master/ipregion.sh" | bash | tee -a "$diag_log" || warn "ipregion check returned non-zero"
        wget -qO - "https://github.com/vernette/censorcheck/raw/master/censorcheck.sh" | bash | tee -a "$diag_log" || warn "censorcheck returned non-zero"
        ok "Pre-flight diagnostics completed."
    else
        info "Skipping pre-flight IP checks (RUN_IP_CHECKS=false)."
    fi
}

# ==============================================================================
# Step 3: Hostname & Global OS Upgrade
# ==============================================================================
configure_system_and_hostname() {
    step "2/8 Setting Hostname & Updating System Packages"
    info "Setting hostname to '${NODE_HOSTNAME}'..."
    hostnamectl set-hostname "$NODE_HOSTNAME" || echo "$NODE_HOSTNAME" > /etc/hostname
    if ! grep -q "$NODE_HOSTNAME" /etc/hosts 2>/dev/null; then
        echo "127.0.1.1 ${NODE_HOSTNAME}" >> /etc/hosts
    fi
    ok "Hostname set to: $(hostname)"

    info "Running non-interactive system upgrade..."
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get upgrade -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold"
    ok "System packages updated."
}

# ==============================================================================
# Step 4: Install BBR, Fail2ban, and Docker
# ==============================================================================
install_core_tools() {
    step "3/8 Installing BBR, Fail2ban, and Docker"

    # BBR
    info "Enabling TCP BBR congestion control..."
    cat > /etc/sysctl.d/99-nodekeeper-bbr.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
    sysctl --system >/dev/null 2>&1 || sysctl -p /etc/sysctl.d/99-nodekeeper-bbr.conf >/dev/null 2>&1 || true
    ok "BBR enabled (current: $(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo 'bbr'))."

    # Fail2ban for SSH
    info "Installing and configuring Fail2ban for SSH..."
    apt-get install -y fail2ban
    mkdir -p /etc/fail2ban/jail.d
    cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled = true
port = ${SSH_PORT}
filter = sshd
maxretry = 5
findtime = 10m
bantime = 1h
ignoreip = 127.0.0.1/8 ::1${PANEL_IP:+ ${PANEL_IP}}
EOF
    systemctl enable fail2ban >/dev/null 2>&1 || true
    systemctl restart fail2ban >/dev/null 2>&1 || true
    ok "Fail2ban installed and protecting SSH on port ${SSH_PORT}."

    # Docker
    if ! command -v docker >/dev/null 2>&1; then
        info "Installing Docker Engine..."
        curl -fsSL https://get.docker.com | sh
    else
        info "Docker is already installed."
    fi
    systemctl enable --now docker >/dev/null 2>&1 || true
    ok "Docker is active ($(docker --version 2>/dev/null || echo 'installed'))."
}

# ==============================================================================
# Step 5: System Hardening (User, Sudo, Docker Group, SSH Keys, SSHD Config)
# ==============================================================================
harden_system() {
    step "4/8 Hardening System & Configuring User '${ADMIN_USER}'"

    if id "$ADMIN_USER" >/dev/null 2>&1; then
        info "User '${ADMIN_USER}' already exists. Updating groups and password..."
    else
        info "Creating user '${ADMIN_USER}'..."
        useradd -m -s /bin/bash "$ADMIN_USER"
    fi

    echo "${ADMIN_USER}:${ADMIN_PASSWORD}" | chpasswd
    usermod -aG sudo,docker "$ADMIN_USER"

    # Ensure passwordless sudo works cleanly for non-interactive tasks
    mkdir -p /etc/sudoers.d
    local safe_admin_user="${ADMIN_USER//[^a-zA-Z0-9_-]/_}"
    local sudoers_file="/etc/sudoers.d/90-nodekeeper-${safe_admin_user}"
    local tmp_sudoers
    tmp_sudoers=$(mktemp /tmp/nodekeeper-sudoers.XXXXXX)
    cat > "$tmp_sudoers" <<EOF
${ADMIN_USER} ALL=(ALL:ALL) NOPASSWD: ALL
EOF
    chmod 440 "$tmp_sudoers"
    if command -v visudo >/dev/null 2>&1 && ! visudo -cf "$tmp_sudoers" >/dev/null 2>&1; then
        rm -f "$tmp_sudoers"
        err "Generated sudoers file failed visudo syntax check!"
        exit 1
    fi
    chown root:root "$tmp_sudoers" 2>/dev/null || true
    mv "$tmp_sudoers" "$sudoers_file"
    chmod 440 "$sudoers_file"

    # Configure SSH public key
    local user_home
    user_home=$(eval echo "~${ADMIN_USER}")
    mkdir -p "${user_home}/.ssh"
    chmod 700 "${user_home}/.ssh"
    touch "${user_home}/.ssh/authorized_keys"

    if [ -n "$SSH_PUBLIC_KEY" ]; then
        if ! grep -Fq "$SSH_PUBLIC_KEY" "${user_home}/.ssh/authorized_keys" 2>/dev/null; then
            echo "$SSH_PUBLIC_KEY" >> "${user_home}/.ssh/authorized_keys"
        fi
    elif [ -f /root/.ssh/authorized_keys ]; then
        cat /root/.ssh/authorized_keys >> "${user_home}/.ssh/authorized_keys"
    fi

    chmod 600 "${user_home}/.ssh/authorized_keys"
    chown -R "${ADMIN_USER}:${ADMIN_USER}" "${user_home}/.ssh"

    # Harden SSH daemon only if at least one authorized key is present for ADMIN_USER
    if [ -s "${user_home}/.ssh/authorized_keys" ]; then
        info "Hardening SSH configuration (disabling root login and password authentication)..."
        mkdir -p /etc/ssh/sshd_config.d
        cat > /etc/ssh/sshd_config.d/99-nodekeeper-hardening.conf <<'EOF'
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PubkeyAuthentication yes
EOF
        # Also update main /etc/ssh/sshd_config in case Include directive isn't first
        sed -i 's/^[[:space:]]*#\?[[:space:]]*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
        sed -i 's/^[[:space:]]*#\?[[:space:]]*PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
        sed -i 's/^[[:space:]]*#\?[[:space:]]*PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config

        if sshd -t 2>/dev/null; then
            systemctl reload ssh >/dev/null 2>&1 || systemctl reload sshd >/dev/null 2>&1 || true
            ok "SSH hardened: Root login disabled, password login disabled, SSH key auth enforced."
        else
            warn "sshd -t reported a warning; reverting sshd drop-in to avoid lockout."
            rm -f /etc/ssh/sshd_config.d/99-nodekeeper-hardening.conf
        fi
    else
        warn "No SSH public key found in ${user_home}/.ssh/authorized_keys! Keeping password authentication enabled to prevent lockout."
    fi
}

# ==============================================================================
# Step 6: Automatic Non-Interactive Cloudflare WARP Installation
# ==============================================================================
install_warp_unattended() {
    step "5/8 Installing Cloudflare WARP (Unattended Native WireGuard)"
    if [ "$INSTALL_WARP" != "true" ]; then
        info "Skipping WARP installation (INSTALL_WARP=${INSTALL_WARP})."
        return 0
    fi

    if ip link show warp >/dev/null 2>&1 && [ -f /etc/wireguard/warp.conf ]; then
        ok "WARP interface is already installed and active."
        return 0
    fi

    apt-get install -y wireguard wireguard-tools

    local arch
    arch=$(uname -m)
    local wgcf_arch="amd64"
    case "$arch" in
        x86_64|amd64) wgcf_arch="amd64" ;;
        aarch64|arm64) wgcf_arch="arm64" ;;
        *) warn "Unsupported architecture for wgcf: $arch. Skipping WARP."; return 0 ;;
    esac

    info "Downloading wgcf (${wgcf_arch})..."
    local wgcf_url=""
    wgcf_url=$(curl -fsSL https://api.github.com/repos/ViRb3/wgcf/releases/latest 2>/dev/null \
        | grep "browser_download_url.*linux_${wgcf_arch}" \
        | cut -d '"' -f 4 | head -n 1 || true)

    if [ -z "$wgcf_url" ]; then
        wgcf_url="https://github.com/ViRb3/wgcf/releases/download/v2.2.22/wgcf_2.2.22_linux_${wgcf_arch}"
    fi

    curl -fsSL "$wgcf_url" -o /usr/local/bin/wgcf
    chmod +x /usr/local/bin/wgcf

    mkdir -p /opt/warp-native/wgcf
    pushd /opt/warp-native/wgcf >/dev/null || return 0

    if [ ! -f wgcf-account.toml ]; then
        info "Registering Cloudflare WARP account via wgcf..."
        local attempt=1
        while [ $attempt -le 4 ]; do
            YES=1 /usr/local/bin/wgcf register --accept-tos >/dev/null 2>&1 && break
            sleep 3
            attempt=$((attempt + 1))
        done
    fi

    if [ -f wgcf-account.toml ]; then
        /usr/local/bin/wgcf generate >/dev/null 2>&1 || true
    fi

    if [ -f wgcf-profile.conf ]; then
        sed -i '/^DNS =/d' wgcf-profile.conf
        if ! grep -q "Table = off" wgcf-profile.conf; then
            sed -i '/^MTU =/aTable = off' wgcf-profile.conf
        fi
        if ! grep -q "PersistentKeepalive = 25" wgcf-profile.conf; then
            sed -i '/^Endpoint =/aPersistentKeepalive = 25' wgcf-profile.conf
        fi
        # Normalize IPv4 WARP endpoint and strip IPv6 address if needed
        sed -i 's/,\s*[0-9a-fA-F:]\+\/128//' wgcf-profile.conf
        sed -i '/Address = [0-9a-fA-F:]\+\/128/d' wgcf-profile.conf
        sed -i 's|^Endpoint = .*|Endpoint = 162.159.192.1:2408|' wgcf-profile.conf
        sed -i 's|^AllowedIPs = .*|AllowedIPs = 0.0.0.0/0|' wgcf-profile.conf

        mkdir -p /etc/wireguard
        cp wgcf-profile.conf /etc/wireguard/warp.conf
        chmod 600 /etc/wireguard/warp.conf

        systemctl stop wg-quick@warp >/dev/null 2>&1 || true
        ip link delete warp >/dev/null 2>&1 || true
        systemctl enable --now wg-quick@warp >/dev/null 2>&1 || true

        if ip link show warp >/dev/null 2>&1; then
            ok "Cloudflare WARP interface 'warp' is UP and enabled on boot (Table = off)."
        else
            warn "WARP interface failed to start automatically; check 'systemctl status wg-quick@warp'."
        fi
    else
        warn "Could not generate wgcf profile (Cloudflare API may be rate-limiting). You can retry later."
    fi

    popd >/dev/null || true
}

