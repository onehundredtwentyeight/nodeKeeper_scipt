parse_args() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -c|--config)
                CONFIG_SOURCE="${2:-}"
                shift 2
                ;;
            -y|--yes|--unattended|--non-interactive)
                UNATTENDED="true"
                shift
                ;;
            --update)
                UPDATE_ONLY="true"
                shift
                ;;
            --reinstall)
                FORCE_REINSTALL="true"
                shift
                ;;
            --mode)
                INSTALL_MODE="${2:-}"
                shift 2
                ;;
            --hostname)
                NODE_HOSTNAME="${2:-}"
                shift 2
                ;;
            --domain)
                SELF_STEAL_DOMAIN="${2:-}"
                shift 2
                ;;
            --cf-token)
                CLOUDFLARE_API_TOKEN="${2:-}"
                shift 2
                ;;
            --panel-ip)
                PANEL_IP="${2:-}"
                shift 2
                ;;
            --node-port)
                NODE_PORT="${2:-2222}"
                shift 2
                ;;
            --secret-key)
                SECRET_KEY="${2:-}"
                shift 2
                ;;
            --xui-ssl)
                XUI_SSL_MODE="${2:-}"
                shift 2
                ;;
            --xui-domain)
                XUI_SSL_DOMAIN="${2:-}"
                shift 2
                ;;
            --xui-user)
                XUI_USERNAME="${2:-}"
                shift 2
                ;;
            --xui-pass)
                XUI_PASSWORD="${2:-}"
                shift 2
                ;;
            --xui-port)
                XUI_PORT="${2:-}"
                shift 2
                ;;
            --xui-path)
                XUI_WEB_BASE_PATH="${2:-}"
                shift 2
                ;;
            --xui-db)
                XUI_DB_TYPE="${2:-}"
                shift 2
                ;;
            --user)
                ADMIN_USER="${2:-node}"
                shift 2
                ;;
            --password)
                ADMIN_PASSWORD="${2:-}"
                shift 2
                ;;
            --ssh-key)
                SSH_PUBLIC_KEY="${2:-}"
                shift 2
                ;;
            --skip-checks)
                RUN_IP_CHECKS="false"
                shift
                ;;
            --no-warp)
                INSTALL_WARP="false"
                shift
                ;;
            --no-auto-update)
                AUTO_UPDATE_ENABLED="false"
                CLI_NO_AUTO_UPDATE="true"
