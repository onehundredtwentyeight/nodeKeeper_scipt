            panel_host="$XUI_SSL_DOMAIN"
        fi
        local full_url="${panel_scheme}://${panel_host}:${XUI_PORT}${XUI_WEB_BASE_PATH:-/}"

        echo -e "--------------------------------------------------------------------"
        echo -e "${C_BOLD}3x-ui Panel Configuration & Credentials (SAVE THESE NOW!):${C_RESET}"
        echo -e "  1) SSL / Domain:     ${C_CYAN}${XUI_SSL_MODE}${C_RESET}$([ "$XUI_SSL_MODE" = "domain" ] && echo " (${XUI_SSL_DOMAIN})" || ([ "$XUI_SSL_MODE" = "ip" ] && echo " (${public_ip})"))"
        echo -e "  2) Panel Username:   ${C_GREEN}${XUI_USERNAME}${C_RESET}"
        echo -e "  2) Panel Password:   ${C_YELLOW}${XUI_PASSWORD}${C_RESET}"
        echo -e "  3) Panel Port:       ${C_CYAN}${XUI_PORT}${C_RESET}"
        echo -e "  4) Panel URI Path:   ${C_CYAN}${XUI_WEB_BASE_PATH:-/}${C_RESET}"
        if [ "$XUI_DB_TYPE" = "postgres" ]; then
            echo -e "  5) Database Backend: ${C_CYAN}postgres${C_RESET} (Docker container: 3xui_postgres, ${XUI_DIR}/pgdata)"
        else
            echo -e "  5) Database Backend: ${C_CYAN}sqlite${C_RESET} (${XUI_DIR}/db/x-ui.db -> /etc/x-ui/)"
        fi
        if [ -n "$PANEL_IP" ]; then
            echo -e "  6) Central Panel IP: ${C_CYAN}${PANEL_IP}${C_RESET} (UFW allows port ${XUI_PORT} ONLY from this IP)"
        else
            echo -e "  6) Central Panel IP: ${C_YELLOW}Unrestricted (port ${XUI_PORT} open to all IPs)${C_RESET}"
        fi
        echo -e "  Panel Access URL:    ${C_CYAN}${C_BOLD}${full_url}${C_RESET}"
        echo -e "  API Key (Token):     ${C_GREEN}${C_BOLD}${XUI_API_TOKEN:-<run 'nodeKeeper xui-token' to generate>}${C_RESET}"
        echo -e "  Compose Directory:   ${C_CYAN}${XUI_DIR}${C_RESET} (owner: ${ADMIN_USER})"
    fi

    echo -e "--------------------------------------------------------------------"
    echo -e "${C_BOLD}Hardened Access Credentials (SAVE THESE NOW!):${C_RESET}"
    echo -e "  Admin User:          ${C_GREEN}${ADMIN_USER}${C_RESET} (passwordless sudo & docker enabled)"
    echo -e "  Admin Password:      ${C_YELLOW}${ADMIN_PASSWORD}${C_RESET}"
    echo -e "  Root SSH Login:      ${C_RED}DISABLED${C_RESET}"
    echo -e "  Password SSH Login:  ${C_RED}$([ -s "/home/${ADMIN_USER}/.ssh/authorized_keys" ] && echo "DISABLED (SSH Key Required)" || echo "ENABLED")${C_RESET}"
    echo -e "  SSH Connect Command: ${C_CYAN}ssh -p ${SSH_PORT} ${ADMIN_USER}@${public_ip}${C_RESET}"
    echo -e "--------------------------------------------------------------------"
    echo -e "${C_BOLD}Management with nodeKeeper:${C_RESET}"
    echo -e "  Interactive Menu:    ${C_CYAN}nodeKeeper${C_RESET}"
    echo -e "  Check Status:        ${C_CYAN}nodeKeeper status${C_RESET}"
    [ "$INSTALL_MODE" = "3xui" ] && echo -e "  3x-ui API Key:       ${C_CYAN}nodeKeeper xui-token${C_RESET}"
    [ "$INSTALL_MODE" = "3xui" ] && echo -e "  3x-ui Native CLI:    ${C_CYAN}nodeKeeper xui${C_RESET}"
    echo -e "  Switch Mode:         ${C_CYAN}nodeKeeper mode [basic|selfsteal-single|selfsteal-multi|3xui]${C_RESET}"
    echo -e "  Schedule Control:    ${C_CYAN}nodeKeeper schedule [enable|disable|status|freq <min> <max>]${C_RESET}"
    echo -e "  Script Updates:      ${C_CYAN}nodeKeeper update [check|now|enable|disable|status]${C_RESET}"
    echo -e "  Disable/Enable Node: ${C_CYAN}nodeKeeper disable${C_RESET} / ${C_CYAN}nodeKeeper enable${C_RESET}"
    echo -e "  Full Uninstall:      ${C_CYAN}nodeKeeper uninstall${C_RESET}"
    echo -e "  Logs Directory:      ${C_CYAN}${NK_LOG_DIR}/${C_RESET}"
    echo -e "${C_GREEN}${C_BOLD}====================================================================${C_RESET}\n"
}

# ==============================================================================
# Main Execution Flow
# ==============================================================================
main() {
    parse_args "$@"
    load_config_source

    if [ "$DRY_RUN" != "true" ] && [ "${EUID:-$(id -u)}" -ne 0 ]; then
        err "Please run this installer as root (e.g. 'sudo bash install.sh' or under root)."
        exit 1
    fi

    if [ "$DRY_RUN" != "true" ]; then
        check_existing_installation
    fi

    collect_parameters
    run_preflight_checks
    configure_system_and_hostname
    install_core_tools
    harden_system
    install_warp_unattended
    install_nodekeeper_cli
    deploy_remnanode_and_schedule
    print_final_overview
}

main "$@"
}
