xui_switch_db_menu() {
    echo -e "\n${C_BOLD}--- 3x-ui Database Backend (current: ${XUI_DB_TYPE:-sqlite}) ---${C_RESET}"
    echo "  1) SQLite     (/opt/3x-ui/db/x-ui.db)"
    echo "  2) PostgreSQL (container: 3xui_postgres, /opt/3x-ui/pgdata)"
    echo "  0) Cancel"
    local db_opt=""
    tty_read "Select target database backend [0-2]: " db_opt ""
    case "$db_opt" in
        1)
            if [ "${XUI_DB_TYPE:-sqlite}" = "sqlite" ]; then
                info "Already using SQLite."
                return 0
            fi
            XUI_DB_TYPE="sqlite"
            save_env
            write_mode_configs "3xui"
            cmd_restart
            ok "Switched 3x-ui database backend to SQLite."
            ;;
        2)
            if [ "${XUI_DB_TYPE:-sqlite}" = "postgres" ]; then
                info "Already using PostgreSQL."
                return 0
            fi
            [ -z "$XUI_PG_PASSWORD" ] && XUI_PG_PASSWORD=$(generate_password)
            XUI_DB_TYPE="postgres"
            save_env
            write_mode_configs "3xui"
            ensure_3xui_db_ready
            if [ -f "${XUI_DIR}/db/x-ui.db" ]; then
                local mig_ans=""
                tty_read "Migrate existing SQLite data (/opt/3x-ui/db/x-ui.db) into PostgreSQL? [Y/n]: " mig_ans "Y"
                if [[ ! "$mig_ans" =~ ^[Nn]$ ]]; then
                    info "Migrating data from SQLite to PostgreSQL..."
                    local dsn="postgres://xui:${XUI_PG_PASSWORD}@127.0.0.1:5432/xui?sslmode=disable"
                    (cd "$XUI_DIR" && docker compose run --rm --no-deps --entrypoint /app/x-ui 3xui migrate-db --src /etc/x-ui/x-ui.db --dsn "$dsn") \
                        && ok "SQLite data migrated to PostgreSQL." \
                        || warn "Migration command reported a warning; starting panel with PostgreSQL."
                fi
            fi
            cmd_restart
            ok "Switched 3x-ui database backend to PostgreSQL."
            ;;
        0) return 0 ;;
        *) warn "Invalid option." ;;
    esac
}

menu_configs() {
    while true; do
        echo -e "\n${C_BOLD}=== Node Configuration Parameters (${INSTALL_MODE}) ===${C_RESET}"
        if [ "$INSTALL_MODE" = "3xui" ]; then
            echo "  1)  View Current 3x-ui Panel Settings & Access URL"
            echo "  2)  Change 3x-ui Username & Password      (current user: ${XUI_USERNAME:-<none>})"
            echo "  3)  Change 3x-ui Panel Port               (current: ${XUI_PORT:-<none>})"
            echo "  4)  Change 3x-ui Panel URI Path           (current: ${XUI_WEB_BASE_PATH:-/})"
            echo "  5)  Manage SSL Certificate / Domain       (current: ${XUI_SSL_MODE:-none}${XUI_SSL_DOMAIN:+ / $XUI_SSL_DOMAIN})"
            echo "  6)  Generate / Rotate API Key (Token) for Central Panel"
            echo "  7)  Reset Two-Factor Authentication (2FA)"
            echo "  8)  Change / Clear Central Panel IP       (current: ${PANEL_IP:-Unrestricted})"
            echo "  9)  Switch / Migrate Database Backend     (current: ${XUI_DB_TYPE:-sqlite})"
            echo "  10) Configure 3x-ui Telegram Bot"
            echo "  11) Open Native 3x-ui CLI Menu (docker exec -it 3xui_app x-ui)"
            echo "  12) Change Server Hostname                (current: $(hostname))"
            echo "  13) Restart WARP Interface"
            echo "  14) Fix Service Directory & Sudo Permissions"
            echo "  0)  Back"
            read -rp "Select option [0-14]: " c_opt
            case "$c_opt" in
                1)
                    xui_show_settings
                    ;;
                2)
                    local def_u
                    def_u="${XUI_USERNAME:-$(generate_xui_username)}"
                    read -rp "Enter new 3x-ui username [Enter for ${def_u}]: " new_u
                    new_u="${new_u:-$def_u}"
                    local def_p
                    def_p=$(generate_password)
                    read -rp "Enter new 3x-ui password [Enter for random: ${def_p}]: " new_p
                    new_p="${new_p:-$def_p}"
                    if [ -n "$new_u" ] && [ -n "$new_p" ]; then
                        XUI_USERNAME="$new_u"
                        save_env
                        if xui_cli setting -username "$new_u" -password "$new_p"; then
                            cmd_restart
                            ok "3x-ui credentials updated (User: ${new_u} | Password: ${new_p})."
                        else
                            err "Failed to update 3x-ui credentials."
                        fi
                    fi
                    ;;
                3)
                    local def_port
                    def_port=$(generate_xui_port)
                    read -rp "Enter new 3x-ui Panel Port [Enter for random: ${def_port}]: " new_port
                    new_port="${new_port:-$def_port}"
                    if validate_port "$new_port"; then
                        if command -v ufw >/dev/null 2>&1 && [ -n "$XUI_PORT" ]; then
                            ufw delete allow "${XUI_PORT}/tcp" >/dev/null 2>&1 || true
                            [ -n "$PANEL_IP" ] && ufw delete allow from "$PANEL_IP" to any port "$XUI_PORT" proto tcp >/dev/null 2>&1 || true
                        fi
                        XUI_PORT="$new_port"
                        save_env
                        xui_cli setting -port "$XUI_PORT" || warn "Could not apply port via x-ui CLI."
                        apply_firewall
                        cmd_restart
                        ok "3x-ui port updated to ${XUI_PORT}. URL: $(xui_panel_url)"
                    else
                        warn "Invalid port number (1-65535)."
                    fi
                    ;;
                4)
                    local def_path
                    def_path=$(generate_xui_base_path)
                    read -rp "Enter new URI path (e.g. /secret/) [Enter for random: ${def_path}]: " new_path
                    new_path="${new_path:-$def_path}"
                    XUI_WEB_BASE_PATH=$(normalize_web_base_path "$new_path")
                    save_env
                    if xui_cli setting -webBasePath "$XUI_WEB_BASE_PATH"; then
                        cmd_restart
                        ok "3x-ui URI path updated to ${XUI_WEB_BASE_PATH}. URL: $(xui_panel_url)"
                    else
                        err "Failed to update 3x-ui URI path."
                    fi
                    ;;
                5)
                    xui_manage_ssl_menu
                    ;;
                6)
                    cmd_xui_token
                    ;;
                7)
                    if xui_cli setting -resetTwoFactor; then
                        cmd_restart
                        ok "Two-factor authentication (2FA) has been reset."
                    else
                        err "Failed to reset 2FA."
                    fi
                    ;;
                8)
                    read -rp "Enter new Central Panel IPv4 (or type 'none' to remove IP restriction): " new_pip
                    if [ "$new_pip" = "none" ] || [ "$new_pip" = "clear" ] || [ -z "$new_pip" ]; then
                        if command -v ufw >/dev/null 2>&1 && [ -n "$PANEL_IP" ] && [ -n "$XUI_PORT" ]; then
                            ufw delete allow from "$PANEL_IP" to any port "$XUI_PORT" proto tcp >/dev/null 2>&1 || true
                        fi
                        PANEL_IP=""
                        save_env
                        apply_firewall
                        ok "Central Panel IP restriction removed (port ${XUI_PORT} is now open to all IPs)."
                    elif validate_ipv4 "$new_pip"; then
                        if command -v ufw >/dev/null 2>&1 && [ -n "$XUI_PORT" ]; then
                            ufw delete allow "${XUI_PORT}/tcp" >/dev/null 2>&1 || true
                            [ -n "$PANEL_IP" ] && ufw delete allow from "$PANEL_IP" to any port "$XUI_PORT" proto tcp >/dev/null 2>&1 || true
                        fi
                        PANEL_IP="$new_pip"
                        save_env
                        apply_firewall
                        ok "Central Panel IP whitelist updated to ${PANEL_IP}."
                    else
                        warn "Invalid IPv4 address."
                    fi
                    ;;
                9)
                    xui_switch_db_menu
                    ;;
                10)
                    read -rp "Enter Telegram Bot Token: " tg_tok
                    read -rp "Enter Telegram Chat ID: " tg_chat
                    read -rp "Enter Telegram Notification Cron (e.g. '@every 1h' or '30 * * * * *', optional): " tg_rt
                    if [ -n "$tg_tok" ] && [ -n "$tg_chat" ]; then
                        local -a tg_args=(-tgbottoken "$tg_tok" -tgbotchatid "$tg_chat" -enabletgbot)
                        [ -n "$tg_rt" ] && tg_args=(-tgbottoken "$tg_tok" -tgbotchatid "$tg_chat" -tgbotRuntime "$tg_rt" -enabletgbot)
                        xui_cli setting "${tg_args[@]}" && cmd_restart && ok "Telegram bot settings updated."
                    else
                        warn "Bot token and Chat ID are required."
                    fi
                    ;;
                11)
                    if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx '3xui_app'; then
                        docker exec -it 3xui_app x-ui
                    else
                        warn "3xui_app container is not currently running. Start it first with 'nodeKeeper start'."
                    fi
                    ;;
                12)
                    read -rp "Enter new full hostname: " new_hn
                    if [ -n "$new_hn" ]; then
                        hostnamectl set-hostname "$new_hn"
                        NODE_HOSTNAME="$new_hn"
                        save_env
                        ok "Hostname updated to ${NODE_HOSTNAME}."
                    fi
                    ;;
                13)
                    systemctl restart wg-quick@warp && ok "WARP restarted." || err "Failed to restart WARP."
                    ;;
                14)
                    fix_service_dir_permissions
                    configure_passwordless_sudo
                    ;;
                0) break ;;
                *) warn "Invalid option." ;;
            esac
        else
            echo "  1) Change Selfsteal Domain     (current: ${SELF_STEAL_DOMAIN:-<none>})"
            echo "  2) Change Cloudflare API Token (current: ${CLOUDFLARE_API_TOKEN:+***set***})"
            echo "  3) Change Panel IP             (current: ${PANEL_IP:-<none>})"
            echo "  4) Change Node Port            (current: ${NODE_PORT})"
            echo "  5) Update Remnanode SECRET_KEY"
            echo "  6) Change Hostname             (current: $(hostname))"
            echo "  7) Restart WARP Interface"
            echo "  8) Fix Service Directory & Sudo Permissions"
            echo "  0) Back"
            read -rp "Select option: " c_opt
            case "$c_opt" in
                1)
                    read -rp "Enter new Selfsteal Domain: " new_dom
                    if [ -n "$new_dom" ]; then
                        SELF_STEAL_DOMAIN="$new_dom"
                        save_env
                        write_mode_configs "$INSTALL_MODE"
                        cmd_restart
                    fi
                    ;;
                2)
                    read -rp "Enter new Cloudflare API Token: " new_cf
                    if [ -n "$new_cf" ]; then
                        CLOUDFLARE_API_TOKEN="$new_cf"
                        save_env
                        write_mode_configs "$INSTALL_MODE"
                        cmd_restart
                    fi
                    ;;
                3)
                    read -rp "Enter new Panel IP: " new_pip
                    if validate_ipv4 "$new_pip"; then
                        if command -v ufw >/dev/null 2>&1 && [ -n "$PANEL_IP" ]; then
                            ufw delete allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp >/dev/null 2>&1 || true
                        fi
                        PANEL_IP="$new_pip"
                        save_env
                        apply_firewall
                        ok "Panel IP updated to ${PANEL_IP}."
                    else
                        warn "Invalid IPv4 address."
                    fi
                    ;;
                4)
                    read -rp "Enter new Node Port [default 2222]: " new_port
                    if validate_port "$new_port"; then
                        if command -v ufw >/dev/null 2>&1 && [ -n "$PANEL_IP" ]; then
                            ufw delete allow from "$PANEL_IP" to any port "$NODE_PORT" proto tcp >/dev/null 2>&1 || true
                        fi
                        NODE_PORT="$new_port"
                        save_env
                        write_mode_configs "$INSTALL_MODE"
                        apply_firewall
                        cmd_restart
                    else
                        warn "Invalid port number (1-65535)."
                    fi
                    ;;
                5)
                    read -rp "Paste new SECRET_KEY: " new_sk
                    if [ -n "$new_sk" ]; then
                        SECRET_KEY="$new_sk"
                        save_env
                        write_mode_configs "$INSTALL_MODE"
                        cmd_restart
                    fi
                    ;;
                6)
                    read -rp "Enter new full hostname: " new_hn
                    if [ -n "$new_hn" ]; then
                        hostnamectl set-hostname "$new_hn"
                        NODE_HOSTNAME="$new_hn"
                        save_env
                        ok "Hostname updated to ${NODE_HOSTNAME}."
                    fi
                    ;;
                7)
                    systemctl restart wg-quick@warp && ok "WARP restarted." || err "Failed to restart WARP."
                    ;;
                8)
                    fix_service_dir_permissions
                    configure_passwordless_sudo
                    ;;
                0) break ;;
                *) warn "Invalid option." ;;
            esac
        fi
    done
}

menu_logs() {
    echo -e "\n${C_BOLD}=== Logs Viewer ===${C_RESET}"
    echo "  1) Remnanode Container Logs (last 100 lines)"
    echo "  2) Caddy Container Logs (last 100 lines)"
    echo "  3) 3x-ui Container Logs (last 100 lines)"
    echo "  4) 3x-ui PostgreSQL Container Logs (last 100 lines)"
    echo "  5) List Maintenance Logs in ${NK_LOG_DIR}"
    echo "  6) View Latest Maintenance Log"
    echo "  7) View Latest Diagnostics / Censorcheck Log"
    echo "  8) View Auto-Update Log"
    echo "  0) Back"
    read -rp "Select option: " l_opt
    case "$l_opt" in
        1) docker logs --tail 100 remnanode 2>&1 || warn "remnanode container not found." ;;
        2) docker logs --tail 100 caddy-remnawave 2>&1 || warn "caddy-remnawave container not found." ;;
        3) docker logs --tail 100 3xui_app 2>&1 || warn "3xui_app container not found." ;;
        4) docker logs --tail 100 3xui_postgres 2>&1 || warn "3xui_postgres container not found." ;;
        5) ls -lh "$NK_LOG_DIR" 2>/dev/null || info "No logs directory." ;;
        6)
            local latest_u
            latest_u=$(ls -t "${NK_LOG_DIR}"/update_*.log 2>/dev/null | head -n1 || true)
            [ -n "$latest_u" ] && cat "$latest_u" || info "No maintenance update logs found."
            ;;
        7)
            local latest_t
            latest_t=$(ls -t "${NK_LOG_DIR}"/tests_*.log 2>/dev/null | head -n1 || true)
            [ -n "$latest_t" ] && cat "$latest_t" || info "No diagnostic test logs found."
            ;;
        8)
            [ -f "$NK_AUTOUPDATE_LOG" ] && tail -n 100 "$NK_AUTOUPDATE_LOG" || info "No auto-update log found."
            ;;
        0) return ;;
    esac
}

interactive_menu() {
    while true; do
        echo -e "\n${C_BOLD}╭──────────────────────────────────────────────────────────╮${C_RESET}"
        echo -e "${C_BOLD}│              nodeKeeper v${NK_VERSION} — Control Panel            │${C_RESET}"
        echo -e "${C_BOLD}╰──────────────────────────────────────────────────────────╯${C_RESET}"
        echo -e "  Host: ${C_CYAN}$(hostname)${C_RESET} | Mode: ${C_CYAN}${INSTALL_MODE}${C_RESET} | Disabled: ${C_CYAN}${SERVER_DISABLED}${C_RESET}"
        echo ""
        echo "  1) Status & Overview"
        echo "  2) Maintenance Schedule (Enable/Disable, Frequency, Logs, Hooks)"
        echo "  3) Change Install Mode (basic / selfsteal-single / selfsteal-multi / 3xui)"
        echo "  4) Restart Services"
        echo "  5) Disable / Enable Server"
        echo "  6) Edit Configurations"
        echo "  7) View Logs"
        echo "  8) Updates & Auto-Update (v${NK_VERSION})"
        echo "  9) Full Uninstall"
        echo "  0) Exit"
        echo ""
        read -rp "Choose option [0-9]: " choice
        case "$choice" in
            1) cmd_status ;;
            2) menu_schedule ;;
            3) cmd_switch_mode ;;
            4) cmd_restart ;;
            5)
                if [ "$SERVER_DISABLED" = "true" ]; then
                    cmd_enable_server
                else
                    cmd_disable_server
                fi
                ;;
            6) menu_configs ;;
            7) menu_logs ;;
            8) menu_update ;;
            9) cmd_uninstall; exit 0 ;;
            0) exit 0 ;;
            *) warn "Invalid option." ;;
        esac
    done
}

show_help() {
    cat <<EOF
nodeKeeper v${NK_VERSION} — Remnawave & 3x-ui Node Management Utility

Usage:
  nodeKeeper                              Open interactive management menu
  nodeKeeper version                      Show installed nodeKeeper version
  nodeKeeper status                       Show node, container, WARP, schedule, and update status
  nodeKeeper start | stop | restart       Control active stack containers (Remnanode/Caddy or 3x-ui)
  nodeKeeper mode [basic|selfsteal-single|selfsteal-multi|3xui]
                                          Switch installation mode
  nodeKeeper xui-token                    Generate / rotate 3x-ui API key (token) for Central Panel
  nodeKeeper xui                          Open native 3x-ui CLI menu inside 3xui_app container
  nodeKeeper schedule [enable|disable|status|refresh|freq <min> <max>|logs <true|false>|extra-cmd "<cmd>"]
                                          Control automated OS & container maintenance schedule
  nodeKeeper update [check|now|enable|disable|status]
                                          Check/apply script updates and control auto-update cron
  nodeKeeper fix-permissions              Fix /opt/remnanode and /opt/3x-ui permissions for ADMIN_USER
  nodeKeeper fix-sudo                     Configure passwordless sudo (NOPASSWD) for ADMIN_USER
  nodeKeeper disable                      Stop node services and close proxy/panel ports
  nodeKeeper enable                       Start node services and open proxy/panel ports
  nodeKeeper logs [remnanode|caddy|3xui|postgres|maint|tests|autoupdate]
                                          View logs
  nodeKeeper uninstall [--yes]            Completely remove stack, cron jobs, and configs
EOF
}

# ==============================================================================
# Entrypoint
# ==============================================================================
if [[ "${1:-}" =~ ^(-h|--help|help)$ ]]; then
    show_help
    exit 0
fi

if [[ "${1:-}" =~ ^(-v|--version|version)$ ]]; then
    echo "nodeKeeper v${NK_VERSION}"
    exit 0
fi

ensure_root "$@"
load_env

SUBCMD="${1:-menu}"
shift || true

case "$SUBCMD" in
    menu)            interactive_menu ;;
    status)          cmd_status ;;
    start)           cmd_start ;;
    stop)            cmd_stop ;;
    restart)         cmd_restart ;;
    disable)         cmd_disable_server ;;
    enable)          cmd_enable_server ;;
    mode)            cmd_switch_mode "${1:-}" ;;
    xui-token)       cmd_xui_token ;;
    xui)
        if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx '3xui_app'; then
            docker exec -it 3xui_app x-ui
        else
            err "3xui_app container is not running."
            exit 1
        fi
        ;;
    fix-permissions) fix_service_dir_permissions ;;
    fix-sudo)        configure_passwordless_sudo ;;
    update)          cmd_update "${1:-now}" "${2:-}" ;;
    schedule)
        S_ACT="${1:-status}"
        case "$S_ACT" in
            enable)  schedule_enable ;;
            disable) schedule_disable ;;
            status)  schedule_status ;;
            refresh)
                generate_maintenance_script
                ok "Maintenance script regenerated."
                ;;
            freq)
                MAINT_MIN_DAYS="${2:-5}"
                MAINT_MAX_DAYS="${3:-10}"
                save_env
                [ "$MAINT_ENABLED" = "true" ] && schedule_enable
                ;;
            logs)
                MAINT_LOGGING="${2:-true}"
                save_env
                generate_maintenance_script
                ok "Maintenance logging set to ${MAINT_LOGGING}"
                ;;
            extra-cmd)
                MAINT_EXTRA_CMD="${2:-}"
                save_env
                generate_maintenance_script
                ok "Extra command set to: ${MAINT_EXTRA_CMD}"
                ;;
            *) err "Unknown schedule action: $S_ACT"; show_help; exit 1 ;;
        esac
        ;;
    logs)
        L_TYPE="${1:-}"
        if [ -z "$L_TYPE" ]; then
            [ "$INSTALL_MODE" = "3xui" ] && L_TYPE="3xui" || L_TYPE="remnanode"
        fi
        case "$L_TYPE" in
            remnanode)  docker logs --tail 100 remnanode ;;
            caddy)      docker logs --tail 100 caddy-remnawave ;;
            3xui|xui)   docker logs --tail 100 3xui_app ;;
            postgres)   docker logs --tail 100 3xui_postgres ;;
            maint)      cat "$(ls -t "${NK_LOG_DIR}"/update_*.log 2>/dev/null | head -n1)" ;;
            tests)      cat "$(ls -t "${NK_LOG_DIR}"/tests_*.log 2>/dev/null | head -n1)" ;;
            autoupdate) [ -f "$NK_AUTOUPDATE_LOG" ] && tail -n 100 "$NK_AUTOUPDATE_LOG" || info "No auto-update log found." ;;
            *)          menu_logs ;;
        esac
        ;;
    uninstall)       cmd_uninstall "${1:-}" ;;
    -h|--help|help)  show_help ;;
    *)               err "Unknown command: $SUBCMD"; show_help; exit 1 ;;
esac
